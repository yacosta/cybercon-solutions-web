# Environment variables for local development
# Copy to `.env` (or `.dev.vars` for Wrangler) and fill in values.
# For production, set these in Cloudflare Workers → cybercon-solutions-web →
# Settings → Variables and Secrets. The Worker reads them at runtime via
# `cloudflare:workers` (not Vite `import.meta.env` build-time substitution).

# Site
PUBLIC_SITE_URL=https://cybercon-solutions.com

# Cloudflare Turnstile (form bot protection)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Form delivery (Web3Forms) — optional email alert; Attio can be the primary CRM sink
WEB3FORMS_ACCESS_KEY=

# Attio CRM — assessment form upserts People (+ Companies) as prospects
# Create an API token in Attio → Workspace settings → Developers
# Scopes: record_permission:read-write, object_configuration:read, note:read-write
# Optional list scope: list_entry:read-write, list_configuration:read
ATTIO_API_KEY=
# Optional: Attio list ID/slug to add every prospect into (People list)
ATTIO_PROSPECTS_LIST_ID=

# Optional Google Analytics (loaded only after cookie consent = accept)
PUBLIC_GA_MEASUREMENT_ID=

# Auth0 (client area at /client/)
# Create a Regular Web Application in Auth0, then set callback/logout URLs
# (see README → Auth0 client area). Domain is host only, no https://.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_BASE_URL=http://localhost:4321
AUTH0_AUDIENCE=

# Signed session cookie for client area (openssl rand -base64 48)
SESSION_SECRET=replace-with-a-long-random-secret

# Website health check (/site-check/, /api/site-check)
# Tier-3 synthesis is provider-agnostic. Auto-picks first available key:
#   GEMINI_API_KEY → OPENAI_API_KEY → ANTHROPIC_API_KEY
# Or force with SITE_CHECK_AI_PROVIDER=gemini|openai|anthropic
# Without any AI key the Worker still runs live fetch (+ BuiltWith if set)
# and returns an honest heuristic report.
#
# Recommendation: Gemini 2.5 Flash — cheap, fast, Google Search grounding
# fits the "search = visibility context only" accuracy rule well.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SITE_CHECK_AI_PROVIDER=
# Optional model override (defaults: gemini-2.5-flash | gpt-4o-mini | claude-haiku-4-5-20251001)
SITE_CHECK_AI_MODEL=
# BuiltWith Free API key (server-side only) — https://api.builtwith.com/
BUILTWITH_API_KEY=
# Optional: proxy scans to n8n (or similar) instead of the native Worker pipeline
SITE_CHECK_WEBHOOK_URL=
# Soft daily caps (Cache API; Cloudflare WAF rate-limit is still recommended)
SITE_CHECK_IP_DAILY_LIMIT=2
SITE_CHECK_GLOBAL_DAILY_LIMIT=25
