# Long-lived cache for hero media (filenames are stable; bump when replacing).
/videos/*
  Cache-Control: public, max-age=31536000, immutable

# Cloudflare Pages / Workers Assets header overrides (agent-ready content types)
/.well-known/api-catalog
  Content-Type: application/linkset+json; charset=utf-8

/.well-known/http-message-signatures-directory
  Content-Type: application/http-message-signatures-directory+json; charset=utf-8

/.well-known/mcp/server-card.json
  Content-Type: application/json; charset=utf-8

/llms.txt
  Content-Type: text/plain; charset=utf-8

# Plain-text sitemap: one absolute URL per line. text/plain so agents
# do not treat the file as binary the way application/xml sometimes is.
/sitemap.txt
  Content-Type: text/plain; charset=utf-8

/llms-full.txt
  Content-Type: text/plain; charset=utf-8

/auth.md
  Content-Type: text/markdown; charset=utf-8

/openapi.json
  Content-Type: application/vnd.oai.openapi+json; charset=utf-8

# Force download for lead-magnet / sample documents
/downloads/*
  Content-Type: application/pdf
  Content-Disposition: attachment
  Cache-Control: public, max-age=86400
