---
/**
 * Loads Google Analytics (gtag) only after cybercon-consent-v1 === "accept".
 * Consent Mode defaults are denied in BaseLayout before any tags run.
 * Set PUBLIC_GA_MEASUREMENT_ID in the Worker env to enable.
 */
import { CONSENT_STORAGE_KEY } from '../lib/consent';

const measurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---

{measurementId && (
  <script define:vars={{ measurementId, STORAGE_KEY: CONSENT_STORAGE_KEY }} is:inline>
    (function () {
      var loaded = false;

      function loadAnalytics() {
        if (loaded || !measurementId) return;
        loaded = true;
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        window.gtag = window.gtag || gtag;
        // Grant analytics only after prior consent; ads stay denied.
        window.gtag('consent', 'update', {
          analytics_storage: 'granted',
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
        });
        window.gtag('js', new Date());
        window.gtag('config', measurementId, { anonymize_ip: true });
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + measurementId;
        document.head.appendChild(s);
      }

      function maybeLoad(value) {
        if (value === 'accept') loadAnalytics();
      }

      try {
        maybeLoad(localStorage.getItem(STORAGE_KEY));
      } catch (e) {}

      window.addEventListener('cybercon:consent', function (e) {
        maybeLoad(e.detail && e.detail.value);
      });
    })();
  </script>
)}
