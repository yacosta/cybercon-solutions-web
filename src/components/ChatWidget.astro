---
import { localePath, type Messages } from '../i18n';
import { turnstileSiteKey } from '../lib/turnstile';
import { site } from '../lib/site';

interface Props {
  locale: 'en' | 'es';
  t: Messages;
}

const { locale, t } = Astro.props;
const copy = t.chat;
const siteKey = turnstileSiteKey();
const assessmentHref = localePath(locale, '/assessment/');
const siteCheckHref = `${localePath(locale, '/services/web-design-development/')}#site-check`;
const contactHref = localePath(locale, '/contact/');
const phoneHref = `tel:${site.phone.replace(/\+/g, '')}`;
---

<div
  class="chat-root"
  data-chat-root
  data-locale={locale}
  data-require-turnstile={siteKey ? 'true' : 'false'}
  hidden
>
  <button
    type="button"
    class="chat-launcher"
    data-chat-open
    aria-haspopup="dialog"
    aria-controls="cybercon-chat-panel"
    aria-expanded="false"
  >
    <span class="chat-launcher-icon" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
        <path
          d="M5 6.5A2.5 2.5 0 0 1 7.5 4h9A2.5 2.5 0 0 1 19 6.5v6A2.5 2.5 0 0 1 16.5 15H11l-3.8 3.2c-.55.46-1.2.08-1.2-.63V15A2.5 2.5 0 0 1 5 12.5v-6Z"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linejoin="round"></path>
      </svg>
    </span>
    <span class="chat-launcher-label">{copy.launcher}</span>
  </button>

  <div
    id="cybercon-chat-panel"
    class="chat-panel"
    data-chat-panel
    role="dialog"
    aria-modal="false"
    aria-labelledby="cybercon-chat-title"
    hidden
  >
    <header class="chat-header">
      <div>
        <p class="chat-eyebrow">{copy.eyebrow}</p>
        <h2 id="cybercon-chat-title" class="chat-title">{copy.title}</h2>
      </div>
      <button type="button" class="chat-close" data-chat-close aria-label={copy.close}>
        <span aria-hidden="true">×</span>
      </button>
    </header>

    <div class="chat-messages" data-chat-messages aria-live="polite"></div>

    <div class="chat-suggestions" data-chat-suggestions>
      {
        copy.suggestions.map((label, index) => (
          <button type="button" class="chat-chip" data-chat-suggestion data-index={index}>
            {label}
          </button>
        ))
      }
    </div>

    <div class="chat-ctas" data-chat-ctas hidden></div>

    <form class="chat-form" data-chat-form>
      <label class="visually-hidden" for="cybercon-chat-input">{copy.inputLabel}</label>
      <textarea
        id="cybercon-chat-input"
        name="message"
        rows="1"
        data-chat-input
        placeholder={copy.placeholder}
        maxlength="800"
        required
      ></textarea>
      {siteKey && (
        <div class="chat-turnstile" data-chat-turnstile hidden>
          <div class="cf-turnstile" data-sitekey={siteKey} data-theme="light" data-size="flexible"></div>
        </div>
      )}
      <button type="submit" class="chat-send btn btn-primary" data-chat-send>{copy.send}</button>
    </form>

    <p class="chat-footnote">
      {copy.footnote}
      {' '}
      <a href={assessmentHref}>{copy.assessmentLink}</a>
      {' · '}
      <a href={`tel:${site.phone.replace(/\+/g, '')}`}>{site.phoneDisplay}</a>
    </p>
  </div>
</div>

<script
  is:inline
  define:vars={{
    locale,
    copy,
    assessmentHref,
    siteCheckHref,
    contactHref,
    phoneHref,
    siteKey,
  }}
>
  (function () {
    var root = document.querySelector('[data-chat-root]');
    if (!root) return;

    // Skip on client portal / very small print contexts later if needed.
    var path = window.location.pathname || '';
    if (path.indexOf('/client') === 0 || path.indexOf('/es/client') === 0) return;

    root.hidden = false;

    var openBtn = root.querySelector('[data-chat-open]');
    var closeBtn = root.querySelector('[data-chat-close]');
    var panel = root.querySelector('[data-chat-panel]');
    var messagesEl = root.querySelector('[data-chat-messages]');
    var suggestionsEl = root.querySelector('[data-chat-suggestions]');
    var ctasEl = root.querySelector('[data-chat-ctas]');
    var form = root.querySelector('[data-chat-form]');
    var input = root.querySelector('[data-chat-input]');
    var sendBtn = root.querySelector('[data-chat-send]');
    var turnstileWrap = root.querySelector('[data-chat-turnstile]');

    var messages = [];
    var busy = false;
    var openedOnce = false;
    var emailCaptured = false;
    var askedEmail = false;

    function welcome() {
      appendAssistant(copy.welcome, [
        { id: 'assessment', label: copy.ctaAssessment, href: assessmentHref },
        { id: 'site-check', label: copy.ctaSiteCheck, href: siteCheckHref },
        { id: 'contact', label: copy.ctaContact, href: contactHref },
      ]);
    }

    function setOpen(open) {
      if (!panel || !openBtn) return;
      panel.hidden = !open;
      openBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
      root.classList.toggle('is-open', open);
      if (open) {
        if (!openedOnce) {
          openedOnce = true;
          welcome();
        }
        window.setTimeout(function () {
          if (input) input.focus();
        }, 50);
      }
    }

    function appendBubble(role, text) {
      if (!messagesEl) return;
      var row = document.createElement('div');
      row.className = 'chat-row chat-row-' + role;
      var bubble = document.createElement('div');
      bubble.className = 'chat-bubble';
      bubble.textContent = text;
      row.appendChild(bubble);
      messagesEl.appendChild(row);
      messagesEl.scrollTop = messagesEl.scrollHeight;
    }

    function renderCtas(ctas) {
      if (!ctasEl) return;
      ctasEl.innerHTML = '';
      if (!ctas || !ctas.length) {
        ctasEl.hidden = true;
        return;
      }
      ctasEl.hidden = false;
      ctas.forEach(function (cta) {
        var a = document.createElement('a');
        a.className = 'chat-cta';
        a.href = cta.href;
        a.textContent = cta.label;
        if (cta.href.indexOf('http') === 0 || cta.href.indexOf('tel:') === 0) {
          if (cta.href.indexOf('http') === 0) {
            a.target = '_blank';
            a.rel = 'noopener noreferrer';
          }
        }
        ctasEl.appendChild(a);
      });
    }

    function appendAssistant(text, ctas) {
      appendBubble('assistant', text);
      renderCtas(ctas || []);
    }

    function maybeShowTurnstile(userTurns) {
      if (!turnstileWrap || !siteKey) return;
      if (userTurns >= 2) {
        turnstileWrap.hidden = false;
        if (!document.querySelector('script[src*="challenges.cloudflare.com/turnstile"]')) {
          var s = document.createElement('script');
          s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
          s.async = true;
          s.defer = true;
          document.head.appendChild(s);
        }
      }
    }

    function turnstileToken() {
      var el = root.querySelector('[name="cf-turnstile-response"]');
      return el && el.value ? el.value : '';
    }

    function setBusy(next) {
      busy = next;
      if (sendBtn) sendBtn.disabled = next;
      if (input) input.disabled = next;
    }

    async function sendMessage(text) {
      var trimmed = (text || '').trim();
      if (!trimmed || busy) return;

      if (suggestionsEl) suggestionsEl.hidden = true;
      appendBubble('user', trimmed);
      messages.push({ role: 'user', content: trimmed });
      if (input) input.value = '';
      setBusy(true);
      maybeShowTurnstile(messages.filter(function (m) { return m.role === 'user'; }).length);

      var typing = document.createElement('div');
      typing.className = 'chat-row chat-row-assistant';
      typing.innerHTML = '<div class="chat-bubble chat-typing" aria-hidden="true"><span></span><span></span><span></span></div>';
      if (messagesEl) {
        messagesEl.appendChild(typing);
        messagesEl.scrollTop = messagesEl.scrollHeight;
      }

      try {
        var res = await fetch('/api/chat/', {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify({
            locale: locale,
            messages: messages,
            turnstileToken: turnstileToken(),
          }),
        });
        var data = await res.json().catch(function () { return {}; });
        if (typing.parentNode) typing.parentNode.removeChild(typing);

        if (!res.ok || !data.reply) {
          appendAssistant(copy.error, [
            { id: 'assessment', label: copy.ctaAssessment, href: assessmentHref },
            { id: 'call', label: copy.ctaCall, href: phoneHref },
          ]);
          return;
        }

        messages.push({ role: 'assistant', content: data.reply });
        appendAssistant(data.reply, data.ctas || []);

        if (data.askEmail && !emailCaptured && !askedEmail) {
          askedEmail = true;
          appendAssistant(copy.askEmail, [
            { id: 'assessment', label: copy.ctaAssessment, href: assessmentHref },
          ]);
        }
        if (data.leadCaptured) emailCaptured = true;
      } catch (err) {
        if (typing.parentNode) typing.parentNode.removeChild(typing);
        appendAssistant(copy.error, [
          { id: 'assessment', label: copy.ctaAssessment, href: assessmentHref },
        ]);
      } finally {
        setBusy(false);
        if (input) input.focus();
      }
    }

    if (openBtn) {
      openBtn.addEventListener('click', function () {
        setOpen(panel && panel.hidden);
      });
    }
    if (closeBtn) {
      closeBtn.addEventListener('click', function () {
        setOpen(false);
        if (openBtn) openBtn.focus();
      });
    }

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && root.classList.contains('is-open')) {
        setOpen(false);
        if (openBtn) openBtn.focus();
      }
    });

    root.querySelectorAll('[data-chat-suggestion]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var idx = Number(btn.getAttribute('data-index') || '0');
        var text = (copy.suggestions && copy.suggestions[idx]) || btn.textContent;
        if (!root.classList.contains('is-open')) setOpen(true);
        sendMessage(text);
      });
    });

    if (form) {
      form.addEventListener('submit', function (event) {
        event.preventDefault();
        sendMessage(input && input.value);
      });
    }

    if (input) {
      input.addEventListener('keydown', function (event) {
        if (event.key === 'Enter' && !event.shiftKey) {
          event.preventDefault();
          sendMessage(input.value);
        }
      });
    }

    // Reveal launcher after a short delay so it doesn’t compete with the hero CTA.
    window.setTimeout(function () {
      root.classList.add('is-ready');
    }, 1200);
  })();
</script>

<style>
  .chat-root {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 40;
    display: grid;
    justify-items: end;
    gap: 0.75rem;
    font-family: var(--font-body);
    opacity: 0;
    transform: translateY(10px);
    pointer-events: none;
    transition: opacity 0.35s ease, transform 0.35s ease;
  }

  .chat-root.is-ready {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .chat-root[hidden] {
    display: none !important;
  }

  .chat-launcher {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    border: 0;
    border-radius: 999px;
    background: var(--navy);
    color: var(--white);
    padding: 0.7rem 1rem 0.7rem 0.85rem;
    box-shadow: 0 12px 28px rgba(15, 44, 76, 0.28);
    cursor: pointer;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.9rem;
  }

  .chat-launcher:hover {
    background: #0a213a;
  }

  .chat-launcher:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus), 0 12px 28px rgba(15, 44, 76, 0.28);
  }

  .chat-launcher-icon {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
  }

  .chat-panel {
    width: min(24.5rem, calc(100vw - 2rem));
    max-height: min(34rem, calc(100vh - 6rem));
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto auto auto auto;
    gap: 0.75rem;
    background: var(--white);
    color: var(--navy);
    border: 1px solid rgba(15, 44, 76, 0.1);
    border-radius: 1.15rem;
    box-shadow: 0 18px 48px rgba(15, 44, 76, 0.22);
    padding: 0.95rem 0.95rem 0.8rem;
    overflow: hidden;
  }

  .chat-panel[hidden] {
    display: none !important;
  }

  .chat-header {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .chat-eyebrow {
    margin: 0 0 0.2rem;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--coral);
    font-weight: 700;
  }

  .chat-title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.05rem;
    line-height: 1.25;
  }

  .chat-close {
    border: 0;
    background: transparent;
    color: var(--body-muted);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    padding: 0.1rem 0.35rem;
    border-radius: 0.35rem;
  }

  .chat-close:hover,
  .chat-close:focus-visible {
    color: var(--navy);
  }

  .chat-close:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
  }

  .chat-messages {
    overflow: auto;
    display: grid;
    gap: 0.65rem;
    align-content: start;
    min-height: 10rem;
    padding-right: 0.15rem;
  }

  .chat-row {
    display: flex;
  }

  .chat-row-user {
    justify-content: flex-end;
  }

  .chat-bubble {
    max-width: 92%;
    padding: 0.7rem 0.85rem;
    border-radius: 0.9rem;
    font-size: 0.92rem;
    line-height: 1.45;
    white-space: pre-wrap;
  }

  .chat-row-assistant .chat-bubble {
    background: #eef2f6;
    color: var(--navy);
    border-bottom-left-radius: 0.35rem;
  }

  .chat-row-user .chat-bubble {
    background: var(--navy);
    color: var(--white);
    border-bottom-right-radius: 0.35rem;
  }

  .chat-typing {
    display: inline-flex;
    gap: 0.3rem;
    align-items: center;
    min-height: 1.1rem;
  }

  .chat-typing span {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 999px;
    background: var(--muted-blue);
    animation: chat-dot 1s infinite ease-in-out;
  }

  .chat-typing span:nth-child(2) {
    animation-delay: 0.15s;
  }

  .chat-typing span:nth-child(3) {
    animation-delay: 0.3s;
  }

  @keyframes chat-dot {
    0%,
    80%,
    100% {
      opacity: 0.35;
      transform: translateY(0);
    }
    40% {
      opacity: 1;
      transform: translateY(-2px);
    }
  }

  .chat-suggestions,
  .chat-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .chat-suggestions[hidden],
  .chat-ctas[hidden] {
    display: none !important;
  }

  .chat-chip,
  .chat-cta {
    border: 1px solid rgba(15, 44, 76, 0.16);
    background: var(--cream);
    color: var(--navy);
    border-radius: 999px;
    padding: 0.4rem 0.7rem;
    font-size: 0.78rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
  }

  .chat-chip:hover,
  .chat-cta:hover {
    border-color: var(--coral);
    color: var(--coral);
  }

  .chat-chip:focus-visible,
  .chat-cta:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
  }

  .chat-form {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.5rem;
    align-items: end;
  }

  .chat-form textarea {
    grid-column: 1 / -1;
    width: 100%;
    resize: none;
    min-height: 2.75rem;
    max-height: 7rem;
    border: 2px solid rgba(15, 44, 76, 0.12);
    border-radius: 0.75rem;
    padding: 0.7rem 0.8rem;
    font: inherit;
    color: var(--navy);
    background: #eef1f4;
  }

  .chat-form textarea:focus {
    outline: none;
    border-color: var(--coral);
    background: var(--white);
    box-shadow: var(--shadow-focus);
  }

  .chat-turnstile {
    grid-column: 1 / -1;
  }

  .chat-send {
    grid-column: 2;
    justify-self: end;
    min-width: 5.5rem;
  }

  .chat-footnote {
    margin: 0;
    font-size: 0.72rem;
    line-height: 1.4;
    color: var(--body-muted);
  }

  .chat-footnote a {
    color: var(--navy);
    font-weight: 600;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .chat-root,
    .chat-typing span {
      transition: none;
      animation: none;
    }
  }

  @media (max-width: 480px) {
    .chat-launcher-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
    }

    .chat-launcher {
      padding: 0.85rem;
      border-radius: 999px;
    }

    .chat-panel {
      width: min(100vw - 1.5rem, 24.5rem);
      max-height: min(70vh, 32rem);
    }
  }
</style>
