---
import { en } from '../i18n/en';
import { es } from '../i18n/es';
import { turnstileSiteKey } from '../lib/turnstile';
import { site } from '../lib/site';

interface Props {
  /** Page locale — initial chat language (visitor can switch EN/ES in the widget). */
  locale: 'en' | 'es';
}

const { locale } = Astro.props;
const siteKey = turnstileSiteKey();
const phoneHref = `tel:${site.phone.replace(/\+/g, '')}`;
const phoneDisplay = site.phoneDisplay;

const catalogs = {
  en: en.chat,
  es: es.chat,
};

const hrefs = {
  en: {
    assessment: '/assessment/',
    siteCheck: '/services/web-design-development/#site-check',
    breachCheck: '/services/cybersecurity/#breach-check',
    contact: '/contact/',
    call: phoneHref,
  },
  es: {
    assessment: '/es/assessment/',
    siteCheck: '/es/services/web-design-development/#site-check',
    breachCheck: '/es/services/cybersecurity/#breach-check',
    contact: '/es/contact/',
    call: phoneHref,
  },
};

const initial = catalogs[locale];
const avatarSrc = '/images/sophia-avatar-160.webp';
const avatarSrcJpg = '/images/sophia-avatar-160.jpg';
const avatarSrc2x = '/images/sophia-avatar.webp';
---

<div
  class="chat-root"
  data-chat-root
  data-locale={locale}
  data-require-turnstile={siteKey ? 'true' : 'false'}
  hidden
>
  <button
    type="button"
    class="chat-launcher"
    data-chat-open
    aria-haspopup="dialog"
    aria-controls="cybercon-chat-panel"
    aria-expanded="false"
  >
    <span class="chat-launcher-avatar" aria-hidden="true">
      <picture>
        <source type="image/webp" srcset={`${avatarSrc} 1x, ${avatarSrc2x} 2x`} />
        <img src={avatarSrcJpg} alt="" width="40" height="40" decoding="async" />
      </picture>
    </span>
    <span class="chat-launcher-label" data-chat-launcher-label>{initial.launcher}</span>
  </button>

  <div
    id="cybercon-chat-panel"
    class="chat-panel"
    data-chat-panel
    role="dialog"
    aria-modal="false"
    aria-labelledby="cybercon-chat-title"
    hidden
  >
    <header class="chat-header">
      <div class="chat-identity">
        <div class="chat-avatar" aria-hidden="true">
          <picture>
            <source type="image/webp" srcset={`${avatarSrc} 1x, ${avatarSrc2x} 2x`} />
            <img
              src={avatarSrcJpg}
              alt=""
              width="48"
              height="48"
              decoding="async"
              data-chat-avatar-img
            />
          </picture>
        </div>
        <div>
          <h2 id="cybercon-chat-title" class="chat-title" data-chat-title>{initial.name}</h2>
          <p class="chat-role" data-chat-role>{initial.role}</p>
        </div>
      </div>
      <div class="chat-header-actions">
        <div class="chat-lang" role="group" aria-label="Language">
          <button type="button" class="chat-lang-btn" data-chat-lang="en" aria-pressed={locale === 'en' ? 'true' : 'false'}>
            EN
          </button>
          <button type="button" class="chat-lang-btn" data-chat-lang="es" aria-pressed={locale === 'es' ? 'true' : 'false'}>
            ES
          </button>
        </div>
        <button type="button" class="chat-close" data-chat-close aria-label={initial.close}>
          <span aria-hidden="true">×</span>
        </button>
      </div>
    </header>

    <div class="chat-messages" data-chat-messages aria-live="polite"></div>

    <div class="chat-suggestions" data-chat-suggestions>
      {
        initial.suggestions.map((label, index) => (
          <button type="button" class="chat-chip" data-chat-suggestion data-index={index}>
            {label}
          </button>
        ))
      }
    </div>

    <div class="chat-ctas" data-chat-ctas hidden></div>

    <form class="chat-form" data-chat-form>
      <label class="visually-hidden" for="cybercon-chat-input" data-chat-input-label>{initial.inputLabel}</label>
      <textarea
        id="cybercon-chat-input"
        name="message"
        rows="1"
        data-chat-input
        placeholder={initial.placeholder}
        maxlength="800"
        required
      ></textarea>
      {siteKey && (
        <div class="chat-turnstile" data-chat-turnstile hidden>
          <div class="cf-turnstile" data-sitekey={siteKey} data-theme="light" data-size="flexible"></div>
        </div>
      )}
      <button type="submit" class="chat-send btn btn-primary" data-chat-send>{initial.send}</button>
    </form>

    <p class="chat-footnote" data-chat-footnote>
      <span data-chat-footnote-text>{initial.footnote}</span>
      {' '}
      <a data-chat-assessment-link href={hrefs[locale].assessment}>{initial.assessmentLink}</a>
      {' · '}
      <a href={phoneHref}>{phoneDisplay}</a>
    </p>
  </div>
</div>

<script
  is:inline
  define:vars={{
    pageLocale: locale,
    catalogs,
    hrefs,
    siteKey,
    phoneHref,
    phoneDisplay,
  }}
>
  (function () {
    var root = document.querySelector('[data-chat-root]');
    if (!root) return;

    root.hidden = false;

    var STORAGE_KEY = 'cybercon_chat_locale';
    var chatLocale = pageLocale;
    try {
      var saved = sessionStorage.getItem(STORAGE_KEY);
      if (saved === 'en' || saved === 'es') chatLocale = saved;
    } catch (e) {}

    var copy = catalogs[chatLocale] || catalogs.en;
    var links = hrefs[chatLocale] || hrefs.en;

    var openBtn = root.querySelector('[data-chat-open]');
    var closeBtn = root.querySelector('[data-chat-close]');
    var panel = root.querySelector('[data-chat-panel]');
    var messagesEl = root.querySelector('[data-chat-messages]');
    var suggestionsEl = root.querySelector('[data-chat-suggestions]');
    var ctasEl = root.querySelector('[data-chat-ctas]');
    var form = root.querySelector('[data-chat-form]');
    var input = root.querySelector('[data-chat-input]');
    var sendBtn = root.querySelector('[data-chat-send]');
    var turnstileWrap = root.querySelector('[data-chat-turnstile]');
    var launcherLabel = root.querySelector('[data-chat-launcher-label]');
    var titleEl = root.querySelector('[data-chat-title]');
    var roleEl = root.querySelector('[data-chat-role]');
    var inputLabelEl = root.querySelector('[data-chat-input-label]');
    var footnoteText = root.querySelector('[data-chat-footnote-text]');
    var assessmentLink = root.querySelector('[data-chat-assessment-link]');

    var messages = [];
    var busy = false;
    var openedOnce = false;
    var emailCaptured = false;
    var askedEmail = false;

    function defaultCtas() {
      return [
        { id: 'assessment', label: copy.ctaAssessment, href: links.assessment },
        { id: 'site-check', label: copy.ctaSiteCheck, href: links.siteCheck },
        { id: 'contact', label: copy.ctaContact, href: links.contact },
      ];
    }

    function applyChrome() {
      copy = catalogs[chatLocale] || catalogs.en;
      links = hrefs[chatLocale] || hrefs.en;
      root.setAttribute('data-locale', chatLocale);
      if (launcherLabel) launcherLabel.textContent = copy.launcher;
      if (titleEl) titleEl.textContent = copy.name;
      if (roleEl) roleEl.textContent = copy.role;
      if (closeBtn) closeBtn.setAttribute('aria-label', copy.close);
      if (input) input.setAttribute('placeholder', copy.placeholder);
      if (inputLabelEl) inputLabelEl.textContent = copy.inputLabel;
      if (sendBtn) sendBtn.textContent = copy.send;
      if (footnoteText) footnoteText.textContent = copy.footnote;
      if (assessmentLink) {
        assessmentLink.textContent = copy.assessmentLink;
        assessmentLink.setAttribute('href', links.assessment);
      }
      root.querySelectorAll('[data-chat-lang]').forEach(function (btn) {
        var lang = btn.getAttribute('data-chat-lang');
        btn.setAttribute('aria-pressed', lang === chatLocale ? 'true' : 'false');
        btn.classList.toggle('is-active', lang === chatLocale);
      });
      if (suggestionsEl && !suggestionsEl.hidden) {
        var chips = suggestionsEl.querySelectorAll('[data-chat-suggestion]');
        chips.forEach(function (chip, index) {
          if (copy.suggestions && copy.suggestions[index]) {
            chip.textContent = copy.suggestions[index];
          }
        });
      }
    }

    function welcome() {
      appendAssistant(copy.welcome, defaultCtas());
    }

    function setOpen(open) {
      if (!panel || !openBtn) return;
      panel.hidden = !open;
      openBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
      root.classList.toggle('is-open', open);
      if (open) {
        if (!openedOnce) {
          openedOnce = true;
          welcome();
        }
        window.setTimeout(function () {
          if (input) input.focus();
        }, 50);
      }
    }

    function prefersReducedMotion() {
      return window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    }

    function smoothScrollMessages(targetTop, durationMs) {
      if (!messagesEl) return;
      var start = messagesEl.scrollTop;
      var change = targetTop - start;
      if (Math.abs(change) < 2) {
        messagesEl.scrollTop = targetTop;
        return;
      }
      if (prefersReducedMotion()) {
        messagesEl.scrollTop = targetTop;
        return;
      }
      var duration = durationMs || 700;
      var startTime = null;
      function easeInOut(t) {
        return t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
      }
      function step(now) {
        if (startTime === null) startTime = now;
        var progress = Math.min(1, (now - startTime) / duration);
        messagesEl.scrollTop = start + change * easeInOut(progress);
        if (progress < 1) window.requestAnimationFrame(step);
      }
      window.requestAnimationFrame(step);
    }

    function revealAnswer(row) {
      if (!row || !messagesEl) return;
      row.classList.add('is-new-answer');
      var answerTop = Math.max(0, row.offsetTop - 10);
      var answerBottom =
        row.offsetTop +
        row.offsetHeight +
        (ctasEl && !ctasEl.hidden ? ctasEl.offsetHeight + 8 : 8);
      var maxScroll = Math.max(0, messagesEl.scrollHeight - messagesEl.clientHeight);
      var desired = Math.min(maxScroll, Math.max(answerTop, answerBottom - messagesEl.clientHeight));
      smoothScrollMessages(desired, 850);
      window.setTimeout(function () {
        row.classList.remove('is-new-answer');
      }, 2200);
    }

    function appendBubble(role, text, options) {
      if (!messagesEl) return null;
      var opts = options || {};
      var row = document.createElement('div');
      row.className = 'chat-row chat-row-' + role;
      var bubble = document.createElement('div');
      bubble.className = 'chat-bubble' + (role === 'assistant' ? ' chat-bubble-answer' : '');
      bubble.textContent = text;
      row.appendChild(bubble);
      messagesEl.appendChild(row);
      if (opts.reveal) {
        window.requestAnimationFrame(function () {
          window.requestAnimationFrame(function () {
            revealAnswer(row);
          });
        });
      } else {
        messagesEl.scrollTop = messagesEl.scrollHeight;
      }
      return row;
    }

    function renderCtas(ctas) {
      if (!ctasEl) return;
      ctasEl.innerHTML = '';
      if (!ctas || !ctas.length) {
        ctasEl.hidden = true;
        return;
      }
      ctasEl.hidden = false;
      ctas.forEach(function (cta) {
        var a = document.createElement('a');
        a.className = 'chat-cta';
        a.href = cta.href;
        a.textContent = cta.label;
        if (cta.href.indexOf('http') === 0) {
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
        }
        ctasEl.appendChild(a);
      });
    }

    function appendAssistant(text, ctas, options) {
      var opts = options || {};
      var row = appendBubble('assistant', text, { reveal: false });
      renderCtas(ctas || []);
      if (opts.reveal && row) {
        window.requestAnimationFrame(function () {
          window.requestAnimationFrame(function () {
            revealAnswer(row);
          });
        });
      } else if (messagesEl) {
        messagesEl.scrollTop = messagesEl.scrollHeight;
      }
      return row;
    }

    function maybeShowTurnstile(userTurns) {
      if (!turnstileWrap || !siteKey) return;
      if (userTurns >= 2) {
        turnstileWrap.hidden = false;
        if (!document.querySelector('script[src*="challenges.cloudflare.com/turnstile"]')) {
          var s = document.createElement('script');
          s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
          s.async = true;
          s.defer = true;
          document.head.appendChild(s);
        }
      }
    }

    function turnstileToken() {
      var el = root.querySelector('[name="cf-turnstile-response"]');
      return el && el.value ? el.value : '';
    }

    function setBusy(next) {
      busy = next;
      if (sendBtn) sendBtn.disabled = next;
      if (input) input.disabled = next;
    }

    function switchLocale(next) {
      if (next !== 'en' && next !== 'es') return;
      if (next === chatLocale) return;
      chatLocale = next;
      try {
        sessionStorage.setItem(STORAGE_KEY, chatLocale);
      } catch (e) {}
      applyChrome();
      // Reset thread so language stays consistent for the visitor.
      messages = [];
      openedOnce = false;
      askedEmail = false;
      if (messagesEl) messagesEl.innerHTML = '';
      if (ctasEl) {
        ctasEl.innerHTML = '';
        ctasEl.hidden = true;
      }
      if (suggestionsEl) suggestionsEl.hidden = false;
      if (root.classList.contains('is-open')) {
        openedOnce = true;
        welcome();
      }
    }

    async function sendMessage(text) {
      var trimmed = (text || '').trim();
      if (!trimmed || busy) return;

      if (suggestionsEl) suggestionsEl.hidden = true;
      appendBubble('user', trimmed);
      messages.push({ role: 'user', content: trimmed });
      if (input) input.value = '';
      setBusy(true);
      maybeShowTurnstile(messages.filter(function (m) { return m.role === 'user'; }).length);

      var typing = document.createElement('div');
      typing.className = 'chat-row chat-row-assistant';
      typing.innerHTML =
        '<div class="chat-bubble chat-typing" aria-hidden="true"><span></span><span></span><span></span></div>';
      if (messagesEl) {
        messagesEl.appendChild(typing);
        messagesEl.scrollTop = messagesEl.scrollHeight;
      }

      try {
        var res = await fetch('/api/chat/', {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify({
            locale: chatLocale,
            messages: messages,
            turnstileToken: turnstileToken(),
          }),
        });
        var data = await res.json().catch(function () { return {}; });
        if (typing.parentNode) typing.parentNode.removeChild(typing);

        if (!res.ok || !data.reply) {
          appendAssistant(
            copy.error,
            [
              { id: 'assessment', label: copy.ctaAssessment, href: links.assessment },
              { id: 'call', label: copy.ctaCall, href: phoneHref },
            ],
            { reveal: true },
          );
          return;
        }

        messages.push({ role: 'assistant', content: data.reply });
        appendAssistant(data.reply, data.ctas || [], { reveal: true });

        if (data.askEmail && !emailCaptured && !askedEmail) {
          askedEmail = true;
          appendAssistant(
            copy.askEmail,
            [{ id: 'assessment', label: copy.ctaAssessment, href: links.assessment }],
            { reveal: true },
          );
        }
        if (data.leadCaptured) emailCaptured = true;
      } catch (err) {
        if (typing.parentNode) typing.parentNode.removeChild(typing);
        appendAssistant(
          copy.error,
          [{ id: 'assessment', label: copy.ctaAssessment, href: links.assessment }],
          { reveal: true },
        );
      } finally {
        setBusy(false);
        if (input) input.focus();
      }
    }

    applyChrome();

    if (openBtn) {
      openBtn.addEventListener('click', function () {
        setOpen(panel && panel.hidden);
      });
    }
    if (closeBtn) {
      closeBtn.addEventListener('click', function () {
        setOpen(false);
        if (openBtn) openBtn.focus();
      });
    }

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && root.classList.contains('is-open')) {
        setOpen(false);
        if (openBtn) openBtn.focus();
      }
    });

    root.querySelectorAll('[data-chat-lang]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        switchLocale(btn.getAttribute('data-chat-lang'));
      });
    });

    root.querySelectorAll('[data-chat-suggestion]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var idx = Number(btn.getAttribute('data-index') || '0');
        var text = (copy.suggestions && copy.suggestions[idx]) || btn.textContent;
        if (!root.classList.contains('is-open')) setOpen(true);
        sendMessage(text);
      });
    });

    if (form) {
      form.addEventListener('submit', function (event) {
        event.preventDefault();
        sendMessage(input && input.value);
      });
    }

    if (input) {
      input.addEventListener('keydown', function (event) {
        if (event.key === 'Enter' && !event.shiftKey) {
          event.preventDefault();
          sendMessage(input.value);
        }
      });
    }

    window.setTimeout(function () {
      root.classList.add('is-ready');
    }, 1200);
  })();
</script>

<style>
  .chat-root {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 40;
    display: grid;
    justify-items: end;
    gap: 0.75rem;
    font-family: var(--font-body);
    opacity: 0;
    transform: translateY(10px);
    pointer-events: none;
    transition: opacity 0.35s ease, transform 0.35s ease;
  }

  .chat-root.is-ready {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .chat-root[hidden] {
    display: none !important;
  }

  .chat-launcher {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    border: 0;
    border-radius: 999px;
    background: var(--navy);
    color: var(--white);
    padding: 0.7rem 1rem 0.7rem 0.85rem;
    box-shadow: 0 12px 28px rgba(15, 44, 76, 0.28);
    cursor: pointer;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.9rem;
  }

  .chat-launcher:hover {
    background: #0a213a;
  }

  .chat-launcher:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus), 0 12px 28px rgba(15, 44, 76, 0.28);
  }

  .chat-launcher-avatar {
    width: 2.15rem;
    height: 2.15rem;
    border-radius: 999px;
    overflow: hidden;
    flex-shrink: 0;
    border: 1.5px solid rgba(255, 255, 255, 0.35);
    background: rgba(255, 255, 255, 0.12);
  }

  .chat-launcher-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .chat-panel {
    width: min(24.5rem, calc(100vw - 2rem));
    max-height: min(34rem, calc(100vh - 6rem));
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto auto auto auto;
    gap: 0.75rem;
    background: var(--white);
    color: var(--navy);
    border: 1px solid rgba(15, 44, 76, 0.1);
    border-radius: 1.15rem;
    box-shadow: 0 18px 48px rgba(15, 44, 76, 0.22);
    padding: 0.95rem 0.95rem 0.8rem;
    overflow: hidden;
  }

  .chat-panel[hidden] {
    display: none !important;
  }

  .chat-header {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .chat-identity {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 0;
  }

  .chat-avatar {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    overflow: hidden;
    flex-shrink: 0;
    border: 2px solid rgba(192, 57, 43, 0.22);
    box-shadow: 0 0 0 3px rgba(192, 57, 43, 0.08);
  }

  .chat-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .chat-header-actions {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .chat-lang {
    display: inline-flex;
    border: 1px solid rgba(15, 44, 76, 0.14);
    border-radius: 999px;
    overflow: hidden;
  }

  .chat-lang-btn {
    border: 0;
    background: transparent;
    color: var(--body-muted);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 0.28rem 0.45rem;
    cursor: pointer;
  }

  .chat-lang-btn.is-active,
  .chat-lang-btn[aria-pressed='true'] {
    background: var(--navy);
    color: var(--white);
  }

  .chat-lang-btn:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
  }

  .chat-eyebrow {
    margin: 0 0 0.2rem;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--coral);
    font-weight: 700;
  }

  .chat-title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.05rem;
    line-height: 1.25;
  }

  .chat-role {
    margin: 0.15rem 0 0;
    font-size: 0.75rem;
    color: var(--body-muted);
    line-height: 1.3;
  }

  .chat-close {
    border: 0;
    background: transparent;
    color: var(--body-muted);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    padding: 0.1rem 0.35rem;
    border-radius: 0.35rem;
  }

  .chat-close:hover,
  .chat-close:focus-visible {
    color: var(--navy);
  }

  .chat-close:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
  }

  .chat-messages {
    overflow: auto;
    display: grid;
    gap: 0.65rem;
    align-content: start;
    min-height: 10rem;
    padding-right: 0.15rem;
  }

  .chat-row {
    display: flex;
    align-items: flex-end;
    gap: 0.45rem;
  }

  .chat-row-user {
    justify-content: flex-end;
  }

  .chat-bubble {
    max-width: 92%;
    padding: 0.7rem 0.85rem;
    border-radius: 0.9rem;
    font-size: 0.92rem;
    line-height: 1.45;
    white-space: pre-wrap;
  }

  .chat-row-assistant .chat-bubble {
    background: #eef2f6;
    color: var(--navy);
    border-bottom-left-radius: 0.35rem;
  }

  .chat-row-assistant .chat-bubble-answer {
    background: linear-gradient(180deg, #fff8f4 0%, #f7efe9 100%);
    border: 1px solid rgba(192, 57, 43, 0.18);
    box-shadow: inset 3px 0 0 var(--coral);
  }

  .chat-row-assistant.is-new-answer .chat-bubble-answer {
    animation: chat-answer-glow 1.8s ease;
  }

  .chat-row-user .chat-bubble {
    background: var(--navy);
    color: var(--white);
    border-bottom-right-radius: 0.35rem;
  }

  @keyframes chat-answer-glow {
    0% {
