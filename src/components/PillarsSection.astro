---
import { localePath, type Messages } from '../i18n';

interface Props {
  locale: 'en' | 'es';
  t: Messages;
}

const { locale, t } = Astro.props;
---

<section class="pillars" aria-labelledby="pillars-title">
  <div class="container">
    <p class="eyebrow">{t.pillars.eyebrow}</p>
    <h2 id="pillars-title">{t.pillars.title}</h2>
    <p class="lede">{t.pillars.lede}</p>

    <div class="pillar-grid">
      {t.pillars.items.map((pillar) => (
        <article class="pillar">
          <h3>{pillar.title}</h3>
          <p>{pillar.body}</p>
          <a href={localePath(locale, pillar.href)}>{pillar.link}</a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .pillars {
    background: var(--white);
    padding: var(--section-pad-y) 0;
  }

  .pillars h2 {
    font-size: clamp(1.75rem, 3vw, 2.35rem);
    margin: 0.5rem 0 0.75rem;
    color: var(--navy);
  }

  .lede {
    color: var(--body-muted);
    max-width: 44rem;
    margin: 0 0 2rem;
  }

  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .pillar {
    padding: 0;
    border-top: 3px solid var(--coral);
    padding-top: 1.15rem;
  }

  .pillar h3 {
    margin: 0 0 0.65rem;
    font-size: 1.35rem;
    color: var(--navy);
  }

  .pillar p {
    margin: 0 0 1rem;
    color: var(--body-muted);
    line-height: 1.6;
    font-size: 0.975rem;
  }

  .pillar a {
    color: var(--navy);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.12em;
  }

  .pillar a:hover {
    color: var(--coral);
  }

  @media (max-width: 800px) {
    .pillar-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
