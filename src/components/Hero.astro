---
import { localePath, type Messages } from '../i18n';
import { industryPath } from '../data/industries';

interface Props {
  locale: 'en' | 'es';
  t: Messages;
  videoSrc?: string;
}

const {
  locale,
  t,
  videoSrc = '/videos/hero-server-racks.webm',
} = Astro.props;

const videoLabel =
  locale === 'es'
    ? 'Vídeo decorativo: ingeniero de redes trabajando entre racks de servidores'
    : 'Decorative video: network engineer walking through server racks and working on a server';

const assessmentHref = localePath(locale, '/assessment/');
const siteCheckHref = `${localePath(locale, '/services/web-design-development/')}#site-check`;

/** Responsive LCP poster — AVIF/WebP + width variants beat the old 86KiB PNG-as-JPG. */
const posterJpg = '/videos/hero-poster.jpg';
const posterAvifSrcset =
  '/videos/hero-poster-768.avif 768w, /videos/hero-poster-960.avif 960w, /videos/hero-poster.avif 1280w';
const posterWebpSrcset =
  '/videos/hero-poster-768.webp 768w, /videos/hero-poster-960.webp 960w, /videos/hero-poster.webp 1280w';
const posterJpgSrcset =
  '/videos/hero-poster-768.jpg 768w, /videos/hero-poster-960.jpg 960w, /videos/hero-poster.jpg 1280w';
const posterSizes = '100vw';

const personaDefs = [
  { id: 'healthcare', slug: 'healthcare-clinics', copy: t.hero.personas.healthcare },
  { id: 'legal', slug: 'legal-professional-services', copy: t.hero.personas.legal },
  { id: 'financial', slug: 'financial-services-insurance', copy: t.hero.personas.financial },
  { id: 'nonprofit', slug: 'education-nonprofits', copy: t.hero.personas.nonprofit },
] as const;

const personaPayload = personaDefs.map((persona) => ({
  id: persona.id,
  lede: persona.copy.lede,
  cta: persona.copy.cta,
  assessmentHref: `${assessmentHref}?industry=${persona.slug}`,
  industryHref: industryPath(locale, persona.slug),
}));
---

<section
  class="hero"
  aria-labelledby="hero-title"
  aria-describedby="hero-lede"
  data-hero
  data-default-lede={t.hero.lede}
  data-default-cta={t.hero.cta}
  data-default-cta-href={assessmentHref}
>
  <div class="hero-media">
    {/*
      LCP surface is this prioritized <img> only. Do not set video[poster] —
      a poster paints above the image and Lighthouse treats that (unprioritized)
      request as LCP. Keep the video transparent until playback starts.
    */}
    <picture>
      <source type="image/avif" srcset={posterAvifSrcset} sizes={posterSizes} />
      <source type="image/webp" srcset={posterWebpSrcset} sizes={posterSizes} />
      <img
        class="hero-poster"
        src={posterJpg}
        srcset={posterJpgSrcset}
        sizes={posterSizes}
        alt={videoLabel}
        width="1280"
        height="800"
        fetchpriority="high"
        loading="eager"
        decoding="sync"
      />
    </picture>
    <video
      class="hero-video"
      muted
      loop
      playsinline
      preload="none"
      tabindex="-1"
      aria-label={videoLabel}
    >
      <source data-src={videoSrc} type="video/webm" />
    </video>
    <div class="hero-overlay"></div>
  </div>

  <div class="hero-content">
    <p class="eyebrow">{t.hero.eyebrow}</p>
    <h1 id="hero-title">{t.hero.title}</h1>

    {/*
      CRO-001: Control keeps the generic hero (this block stays hidden).
      Orchestrator reveals for V1 (assessment CTA) / V2 (industry-page CTA).
    */}
    <div
      class="hero-personas"
      data-hero-personas
      data-cro-experiment="cro-001"
      data-cro-component="hero-personas"
      hidden
    >
      <p class="hero-personas-label" id="hero-personas-label">{t.hero.personasLabel}</p>
      <div
        class="hero-persona-tabs"
        role="tablist"
        aria-labelledby="hero-personas-label"
        data-hero-tablist
      >
        {
          personaDefs.map((persona, index) => (
            <button
              type="button"
              class="hero-persona-tab"
              role="tab"
              id={`hero-persona-${persona.id}`}
              data-persona={persona.id}
              aria-selected="false"
              aria-controls="hero-lede"
              tabindex={index === 0 ? 0 : -1}
            >
              {persona.copy.label}
            </button>
          ))
        }
      </div>
      <script
        type="application/json"
        data-hero-persona-data
        set:html={JSON.stringify(personaPayload)}
      />
    </div>

    <p id="hero-lede" class="lede" data-hero-lede role="tabpanel" aria-live="polite">
      {t.hero.lede}
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary" href={assessmentHref} data-hero-cta>{t.hero.cta}</a>
      <a class="btn btn-ghost" href={siteCheckHref}>{t.hero.ctaSecondary}</a>
      <p class="status">
        <span class="status-dot" aria-hidden="true"></span>
        {t.hero.status}
      </p>
    </div>
    <p class="sr-only">{videoLabel}</p>
  </div>
</section>

<script>
  function loadHeroVideo() {
    const video = document.querySelector('.hero-video');
    if (!(video instanceof HTMLVideoElement)) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      video.remove();
      return;
    }
    // Skip ~1MB WebM on narrow viewports / Save-Data — poster is the LCP image.
    const narrow = window.matchMedia('(max-width: 768px)').matches;
    const connection = /** @type {{ saveData?: boolean } | undefined } */ (
      'connection' in navigator ? navigator.connection : undefined
    );
    if (narrow || connection?.saveData) {
      video.remove();
      return;
    }
    const source = video.querySelector('source[data-src]');
    if (source instanceof HTMLSourceElement && source.dataset.src) {
      source.src = source.dataset.src;
      source.removeAttribute('data-src');
      video.load();
      video
        .play()
        .then(() => {
          video.classList.add('is-playing');
        })
        .catch(() => {
          /* Autoplay blocked — prioritized poster image stays visible */
        });
    }
  }

  /**
   * @typedef {{ id: string, lede: string, cta: string, assessmentHref: string, industryHref: string }} PersonaCopy
   */

  function initHeroPersonas() {
    const hero = document.querySelector('[data-hero]');
    if (!(hero instanceof HTMLElement)) return;

    const tablist = hero.querySelector('[data-hero-tablist]');
    const ledeEl = hero.querySelector('[data-hero-lede]');
    const ctaEl = hero.querySelector('[data-hero-cta]');
    const dataEl = hero.querySelector('[data-hero-persona-data]');
    if (
      !(tablist instanceof HTMLElement) ||
      !(ledeEl instanceof HTMLElement) ||
      !(ctaEl instanceof HTMLAnchorElement) ||
      !(dataEl instanceof HTMLScriptElement)
    ) {
      return;
    }

    /** @type {PersonaCopy[]} */
    let personas = [];
    try {
      personas = JSON.parse(dataEl.textContent || '[]');
    } catch {
      return;
    }
    if (!Array.isArray(personas) || personas.length === 0) return;

    const byId = new Map(personas.map((persona) => [persona.id, persona]));
    const tabs = Array.from(tablist.querySelectorAll('[role="tab"]')).filter(
      (el) => el instanceof HTMLButtonElement,
    );
    if (tabs.length === 0) return;

    const defaults = {
      lede: hero.dataset.defaultLede || ledeEl.textContent || '',
      cta: hero.dataset.defaultCta || ctaEl.textContent || '',
      href: hero.dataset.defaultCtaHref || ctaEl.getAttribute('href') || '/',
    };

    const storageKey = 'cybercon-hero-persona';

    /**
     * @param {string | null} personaId
     * @param {{ persist?: boolean }} [opts]
     */
    function selectPersona(personaId, opts = {}) {
      const persona = personaId ? byId.get(personaId) : undefined;
      const activeId = persona ? persona.id : null;

      for (const tab of tabs) {
        const selected = tab.dataset.persona === activeId;
        tab.setAttribute('aria-selected', selected ? 'true' : 'false');
        tab.tabIndex = selected || (!activeId && tab === tabs[0]) ? 0 : -1;
        tab.classList.toggle('is-active', selected);
      }

      if (persona) {
        const arm = (
          hero.querySelector('[data-cro-experiment="cro-001"]')?.getAttribute('data-cro-arm') ||
          document.documentElement.getAttribute('data-cro-001') ||
          'V1'
        ).toUpperCase();
        ledeEl.textContent = persona.lede;
        ctaEl.textContent = persona.cta;
        ctaEl.href = arm === 'V2' ? persona.industryHref : persona.assessmentHref;
        hero.dataset.activePersona = persona.id;
        if (opts.persist !== false) {
          try {
            sessionStorage.setItem(storageKey, persona.id);
          } catch {
            /* private mode */
          }
        }
      } else {
        ledeEl.textContent = defaults.lede;
        ctaEl.textContent = defaults.cta;
        ctaEl.href = defaults.href;
        delete hero.dataset.activePersona;
        if (opts.persist !== false) {
          try {
            sessionStorage.removeItem(storageKey);
          } catch {
            /* private mode */
          }
        }
      }
    }

    tablist.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const tab = target.closest('[role="tab"]');
      if (!(tab instanceof HTMLButtonElement) || !tablist.contains(tab)) return;
      const id = tab.dataset.persona || null;
      const already = tab.getAttribute('aria-selected') === 'true';
      selectPersona(already ? null : id);
    });

    tablist.addEventListener('keydown', (event) => {
      if (!(event instanceof KeyboardEvent)) return;
      const currentIndex = tabs.findIndex((tab) => tab.tabIndex === 0);
      if (currentIndex < 0) return;

      let nextIndex = currentIndex;
      if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
        nextIndex = (currentIndex + 1) % tabs.length;
      } else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
        nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
      } else if (event.key === 'Home') {
        nextIndex = 0;
      } else if (event.key === 'End') {
        nextIndex = tabs.length - 1;
      } else if (event.key === 'Enter' || event.key === ' ') {
        const tab = tabs[currentIndex];
        const id = tab.dataset.persona || null;
        const already = tab.getAttribute('aria-selected') === 'true';
        event.preventDefault();
        selectPersona(already ? null : id);
        return;
      } else {
        return;
      }

      event.preventDefault();
      const next = tabs[nextIndex];
      for (const tab of tabs) tab.tabIndex = -1;
      next.tabIndex = 0;
      next.focus();
    });

    function armIsTreatment() {
      const host = hero.querySelector('[data-cro-experiment="cro-001"]');
      const arm = (
        (host instanceof HTMLElement && host.getAttribute('data-cro-arm')) ||
        document.documentElement.getAttribute('data-cro-001') ||
        ''
      ).toUpperCase();
      return arm === 'V1' || arm === 'V2';
    }

    function restoreStoredPersona() {
      if (!armIsTreatment()) return;
      let initial = null;
      try {
        initial = sessionStorage.getItem(storageKey);
      } catch {
        initial = null;
      }
      if (initial && byId.has(initial)) {
        selectPersona(initial, { persist: false });
      }
    }

    restoreStoredPersona();
    document.addEventListener('cro:assigned', (event) => {
      if (!(event instanceof CustomEvent)) return;
      if (event.detail?.id !== 'cro-001') return;
      if (event.detail?.arm === 'C') {
        selectPersona(null, { persist: false });
      } else {
        restoreStoredPersona();
      }
    });
  }

  if (document.readyState === 'complete') {
    setTimeout(loadHeroVideo, 200);
  } else {
    window.addEventListener('load', () => setTimeout(loadHeroVideo, 200), { once: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroPersonas, { once: true });
  } else {
    initHeroPersonas();
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: min(88vh, 760px);
    display: grid;
    align-items: end;
    color: var(--white);
    overflow: hidden;
    isolation: isolate;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-poster,
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
    aspect-ratio: 1280 / 800;
  }

  .hero-video {
    opacity: 0;
    transition: opacity 0.45s ease;
  }

  .hero-video.is-playing {
    opacity: 1;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(105deg, rgba(15, 44, 76, 0.92) 0%, rgba(15, 44, 76, 0.72) 48%, rgba(15, 44, 76, 0.45) 100%),
      linear-gradient(to top, rgba(15, 44, 76, 0.85) 0%, transparent 45%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    width: min(38rem, calc(100% - (2 * var(--page-gutter))));
    margin: 0;
    margin-left: var(--page-inline);
    padding: clamp(5rem, 12vw, 7rem) 0 clamp(2.5rem, 6vw, 4rem);
    justify-self: start;
  }

  .hero h1 {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
    margin: 0.75rem 0 1rem;
    color: var(--white);
    text-shadow: 0 1px 18px rgba(0, 0, 0, 0.35);
  }

  .hero-personas {
    margin: 0 0 1rem;
  }

  .hero-personas-label {
    margin: 0 0 0.5rem;
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--secondary-dark);
  }

  .hero-persona-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.15rem;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
  }

  .hero-persona-tab {
    appearance: none;
    background: transparent;
    border: 0;
    border-bottom: 2px solid transparent;
    margin: 0 0 -1px;
    padding: 0.55rem 0.7rem;
    color: rgba(255, 255, 255, 0.78);
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.2;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .hero-persona-tab:hover,
  .hero-persona-tab:focus-visible {
    color: var(--white);
  }

  .hero-persona-tab:focus-visible {
    outline: 2px solid var(--coral);
    outline-offset: 2px;
  }

  .hero-persona-tab.is-active,
  .hero-persona-tab[aria-selected='true'] {
    color: var(--white);
    border-bottom-color: var(--coral);
  }

  .lede {
    color: var(--secondary-dark);
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    line-height: 1.65;
    margin-bottom: 1.5rem;
    /* Reserve space for the longest persona lede to limit CLS on swap */
    min-height: 6.6em;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.25rem;
  }

  .hero-actions .btn-primary {
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.28);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--secondary-dark);
    font-size: 0.9375rem;
    margin: 0;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--coral);
    flex-shrink: 0;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 480px) {
    .hero-persona-tab {
      padding: 0.5rem 0.55rem;
      font-size: 0.8125rem;
    }

    .lede {
      min-height: 8.2em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-video {
      display: none !important;
    }

    .hero-persona-tab {
      transition: none;
    }
  }
</style>
