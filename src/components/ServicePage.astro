---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import SiteCheck from './SiteCheck.astro';
import BreachCheck from './BreachCheck.astro';
import type { Service } from '../data/services';
import { getServiceDetails } from '../data/service-details';
import { buildServiceEditorial } from '../lib/service-editorial';
import { getMessages, localePath } from '../i18n';
import { faqPageJsonLd, jsonLdScript, serviceJsonLd, webDesignOfferCatalogJsonLd } from '../lib/seo';

interface Props {
  locale: 'en' | 'es';
  service: Service;
}

const { locale, service } = Astro.props;
const t = getMessages(locale);
const details = getServiceDetails(service.slug);
if (!details) {
  throw new Error(`Missing service details for slug: ${service.slug}`);
}

const copy = buildServiceEditorial(service, details, locale, t);
const path = locale === 'es' ? `/es/services/${service.slug}/` : `/services/${service.slug}/`;
const homePath = localePath(locale, '/');
const assessmentHref = localePath(locale, '/assessment/');
const siteCheckHref = `${localePath(locale, '/services/web-design-development/')}#site-check`;
const featureBodyParas = copy.feature.body.split(/\n\n+/).filter(Boolean);
const showSiteCheck = service.slug === 'web-design-development';
const showBreachCheck = service.slug === 'cybersecurity';
const secondaryCtaHref = showBreachCheck
  ? '#breach-check'
  : showSiteCheck
    ? '#site-check'
    : siteCheckHref;
const secondaryCtaLabel = showBreachCheck
  ? t.breachCheck.ctaSecondary
  : copy.cta.secondary ?? t.servicePage.ctaSecondary;
---

<BaseLayout
  locale={locale}
  title={details.metaTitle[locale]}
  description={details.metaDescription[locale]}
  path={path}
  breadcrumbs={[
    { name: locale === 'es' ? 'Inicio' : 'Home', path: homePath },
    { name: service.title[locale], path },
  ]}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonLdScript(serviceJsonLd(service, locale))} />
    <script type="application/ld+json" set:html={jsonLdScript(faqPageJsonLd(details.faqs, locale))} />
    {showSiteCheck && (
      <script
        type="application/ld+json"
        set:html={jsonLdScript(webDesignOfferCatalogJsonLd(locale))}
      />
    )}
  </Fragment>

  <Header slot="header" locale={locale} t={t} variant="light" />

  <article class="wd" data-pagefind-body>
    <figure class="wd-banner">
      <picture>
        <source type="image/webp" srcset={copy.feature.image.webpSrcset} sizes="100vw" />
        <img
          src={copy.feature.image.jpg}
          srcset={copy.feature.image.jpgSrcset}
          sizes="100vw"
          alt={copy.feature.imageAlt}
          width={copy.feature.image.width}
          height={copy.feature.image.height}
          decoding="async"
          fetchpriority="high"
        />
      </picture>
    </figure>

    <section class="wd-hero wd-hero-cta-split container" aria-labelledby="wd-hero-title">
      <h1 id="wd-hero-title" class="wd-hero-title">{copy.displayTitle}</h1>
      <div class="wd-hero-copy">
        <p class="wd-hero-lede">{copy.lede}</p>
      </div>
      <div class="wd-hero-cta-col">
        <div class="wd-hero-actions">
          <a class="btn btn-primary" href={assessmentHref}>{copy.cta.button}</a>
          <a class="wd-text-link" href={secondaryCtaHref}>{secondaryCtaLabel}</a>
        </div>
        <p class="wd-hero-note">{copy.replyNote}</p>
      </div>
    </section>

    <hr class="wd-rule" />

    <section class="wd-split container" aria-labelledby="wd-audience-title">
      <div class="wd-split-lead">
        <p class="wd-label">{copy.audience.label}</p>
        <h2 id="wd-audience-title">{copy.audience.title}</h2>
      </div>
      <div class="wd-split-body">
        {copy.audience.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>

    <hr class="wd-rule" />

    <section class="wd-process container" aria-labelledby="wd-process-title">
      <h2 id="wd-process-title" class="wd-label">{copy.process.label}</h2>
      <ol class="wd-steps">
        {copy.process.steps.map((step) => (
          <li class="wd-step">
            <div class="wd-step-index">
              <span class="wd-step-mark" aria-hidden="true"></span>
              <span class="wd-step-num">{step.number}</span>
            </div>
            <h3 class="wd-step-title">{step.title}</h3>
            <p class="wd-step-body">{step.body}</p>
          </li>
        ))}
      </ol>
    </section>

    {copy.pricing && (
      <section class="wd-pricing" aria-labelledby="wd-pricing-title" id="pricing">
        <div class="container">
          <header class="wd-pricing-head">
            <p class="wd-label">{copy.pricing.eyebrow}</p>
            <h2 id="wd-pricing-title">{copy.pricing.title}</h2>
            <p class="wd-pricing-lede">{copy.pricing.lede}</p>
          </header>
          <div class="wd-pricing-grid">
            {copy.pricing.tiers.map((tier) => (
              <article class:list={['wd-price-card', { featured: tier.featured }]}>
                {tier.featured && tier.badge && (
                  <p class="wd-price-badge">{tier.badge}</p>
                )}
                <h3>{tier.name}</h3>
                <p class="wd-price-amount">
                  <strong>{tier.priceFrom}</strong>
                  {tier.priceTo && <span>{tier.priceTo}</span>}
                </p>
                <p class="wd-price-desc">{tier.description}</p>
                <ul class="wd-price-features">
                  {tier.features.map((feature) => (
                    <li>
                      <span class="wd-price-check" aria-hidden="true">✓</span>
                      {feature}
                    </li>
                  ))}
                </ul>
                <a
                  class:list={['wd-price-cta', { primary: tier.featured }]}
                  href={assessmentHref}
                >
                  {tier.cta}
                </a>
              </article>
            ))}
          </div>
          {copy.pricing.shared && (
            <div class="wd-pricing-shared">
              <h3 class="wd-pricing-shared-title">{copy.pricing.shared.title}</h3>
              <ul class="wd-pricing-shared-list">
                {copy.pricing.shared.items.map((item) => (
                  <li>
                    <h4 class="wd-pricing-shared-item-title">{item.title}</h4>
                    <p>{item.body}</p>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {copy.pricing.footnote && (
            <p class="wd-pricing-footnote">{copy.pricing.footnote}</p>
          )}
        </div>
      </section>
    )}

    {showSiteCheck && <SiteCheck locale={locale} t={t} variant="embed" />}
    {showBreachCheck && <BreachCheck locale={locale} t={t} variant="embed" />}

    {!showSiteCheck && !showBreachCheck && <hr class="wd-rule" />}

    <section class="wd-after container" aria-labelledby="wd-feature-title">
      <header class="wd-after-head">
        <p class="wd-label">{copy.feature.label}</p>
        <h2 id="wd-feature-title">{copy.feature.title}</h2>
      </header>
      <div class="wd-after-body">
        {featureBodyParas.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      {copy.included.length > 0 && (
        <ul class="wd-included">
          {copy.included.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )}
    </section>

    <section class="wd-faq container" aria-labelledby="wd-faq-title">
      <h2 id="wd-faq-title" class="wd-label">{copy.faqLabel}</h2>
      <dl class="wd-faq-list">
        {copy.faqs.map((faq) => (
          <div class="wd-faq-row" id={faq.id}>
            <dt>{faq.question}</dt>
            <dd>{faq.answer}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="wd-cta" aria-labelledby="wd-cta-title">
      <div class="wd-cta-shell container">
        <div class="wd-cta-copy">
          <h2 id="wd-cta-title">{copy.cta.title}</h2>
          <p class="wd-cta-lede">{copy.cta.body}</p>
          <div class="wd-cta-actions">
            <a class="wd-cta-btn" href={assessmentHref}>{copy.cta.button}</a>
            <a class="wd-cta-secondary" href={secondaryCtaHref}>{secondaryCtaLabel}</a>
          </div>
        </div>
      </div>
      <figure class="wd-cta-media" aria-hidden="true">
        <picture>
          <source
            type="image/webp"
            srcset="/images/service-cta-desk-768.webp 768w, /images/service-cta-desk-960.webp 960w, /images/service-cta-desk.webp 1280w"
            sizes="(max-width: 860px) 100vw, 55vw"
          />
          <img
            src="/images/service-cta-desk.jpg"
            srcset="/images/service-cta-desk-768.jpg 768w, /images/service-cta-desk-960.jpg 960w, /images/service-cta-desk.jpg 1280w"
            sizes="(max-width: 860px) 100vw, 55vw"
            alt=""
            width="1280"
            height="854"
            loading="lazy"
            decoding="async"
          />
        </picture>
      </figure>
    </section>
  </article>

  <Footer slot="footer" locale={locale} t={t} />
</BaseLayout>

<style is:global>
  body:has(.wd) {
    background: #f3f3f3;
  }

  body:has(.wd) .site-header.light {
    background: #f3f3f3;
  }

  .wd-banner {
    margin: 0;
    width: 100%;
    max-height: min(42vw, 420px);
    overflow: hidden;
    background: var(--navy);
  }

  .wd-banner img {
    display: block;
    width: 100%;
    height: min(42vw, 420px);
    object-fit: cover;
    object-position: center 35%;
  }
</style>

<style>
  .wd {
    background: #f3f3f3;
    color: var(--navy);
  }

  .wd :global(h1),
  .wd :global(h2),
  .wd :global(h3) {
    font-family: var(--font-heading);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--navy);
  }

  .wd-label,
  .wd :global(h2.wd-label) {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--button-red);
    margin: 0 0 1rem;
  }

  .wd-rule {
    border: 0;
    border-top: 1px solid rgba(15, 44, 76, 0.14);
    margin: 0;
  }

  .wd-hero {
    padding-block: clamp(2.75rem, 6vw, 4.5rem) clamp(2.5rem, 5vw, 3.75rem);
  }

  .wd-hero-cta-split {
    display: grid;
    gap: clamp(1.25rem, 2.5vw, 1.75rem) clamp(1.5rem, 3vw, 2.5rem);
    align-items: end;
  }

  .wd-hero-cta-split .wd-hero-title {
    grid-column: 1 / -1;
    max-width: none;
    margin: 0;
    font-size: clamp(1.65rem, 4.2vw, 3.75rem);
  }

  @media (min-width: 480px) {
    .wd-hero-cta-split .wd-hero-title {
      white-space: nowrap;
    }
  }

  @media (min-width: 860px) {
    .wd-hero-cta-split {
      grid-template-columns: minmax(0, 1.35fr) minmax(14rem, 0.85fr);
      column-gap: clamp(2rem, 4vw, 3.5rem);
      align-items: end;
    }

    .wd-hero-cta-col {
      justify-self: end;
      text-align: right;
      max-width: 22rem;
    }

    .wd-hero-cta-col .wd-hero-actions {
      justify-content: flex-end;
    }
  }

  .wd-hero-title {
    font-size: clamp(2.35rem, 6vw, 3.75rem);
    line-height: 1.05;
    max-width: 16ch;
    margin: 0 0 1.25rem;
  }

  .wd-hero-lede {
    max-width: 42rem;
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    line-height: 1.55;
    color: var(--navy);
    margin: 0 0 1.75rem;
  }

  .wd-hero-cta-split .wd-hero-lede {
    margin-bottom: 0;
  }

  .wd-hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.15rem 1.5rem;
    margin-bottom: 1rem;
  }

  .wd-hero-cta-col .wd-hero-actions {
    margin-bottom: 0.85rem;
  }

  .wd-text-link {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--button-red);
    text-decoration: none;
  }

  .wd-text-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .wd-hero-note {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--body-muted);
  }

  .wd-split {
    display: grid;
    gap: 1.75rem 3rem;
    padding-block: clamp(2.5rem, 5vw, 3.75rem);
  }

  .wd-split-lead h2 {
    font-size: clamp(1.55rem, 3vw, 2.05rem);
    line-height: 1.2;
    margin: 0;
    max-width: 22ch;
  }

  .wd-split-body {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .wd-split-body p {
    margin: 0;
    color: var(--navy);
    font-size: 1.015rem;
    line-height: 1.6;
  }

  @media (min-width: 860px) {
    .wd-split {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      align-items: start;
    }
  }

  .wd-process {
    padding-block: clamp(2.5rem, 5vw, 3.75rem);
  }

  .wd-steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .wd-step {
    display: grid;
    gap: 0.65rem 1.5rem;
    padding-block: 1.5rem;
    border-top: 1px solid rgba(15, 44, 76, 0.14);
  }

  .wd-step:last-child {
    border-bottom: 1px solid rgba(15, 44, 76, 0.14);
  }

  .wd-step-index {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .wd-step-mark {
    width: 0.55rem;
    height: 0.55rem;
    background: var(--button-red);
    flex-shrink: 0;
  }

  .wd-step-num {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.04em;
    color: var(--navy);
  }

  .wd-step-title {
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
    margin: 0;
    line-height: 1.15;
  }

  .wd-step-body {
    margin: 0;
    color: var(--body-muted);
    font-size: 1.015rem;
    line-height: 1.55;
    max-width: 36rem;
  }

  @media (min-width: 860px) {
    .wd-step {
      grid-template-columns: 3.75rem minmax(11rem, 0.75fr) minmax(14rem, 1.25fr);
      align-items: start;
      column-gap: clamp(1.5rem, 4vw, 3rem);
      padding-block: 1.85rem;
    }

    .wd-step-body {
      justify-self: end;
      text-align: left;
      max-width: 30rem;
    }
  }

  .wd-pricing {
    background:
      radial-gradient(900px 360px at 8% 0%, rgba(192, 57, 43, 0.07), transparent 55%),
      radial-gradient(800px 320px at 92% 10%, rgba(15, 44, 76, 0.06), transparent 50%),
      var(--cream);
    padding-block: clamp(2.75rem, 6vw, 4.5rem);
    border-block: 1px solid rgba(15, 44, 76, 0.1);
  }

  .wd-pricing-head {
    text-align: center;
    margin-bottom: clamp(2rem, 4vw, 2.75rem);
  }

  .wd-pricing-head .wd-label {
    margin-bottom: 0.75rem;
  }

  .wd-pricing-head h2 {
    margin: 0 auto;
    max-width: 40rem;
    font-size: clamp(1.75rem, 3vw, 2.35rem);
    letter-spacing: -0.02em;
  }

  .wd-pricing-lede {
    margin: 1rem auto 0;
    max-width: 44rem;
    color: var(--body-muted);
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .wd-pricing-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 720px) {
    .wd-pricing-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .wd-pricing-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.35rem;
      align-items: stretch;
    }
  }

  .wd-price-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid rgba(15, 44, 76, 0.12);
    border-radius: var(--radius-md);
    padding: 1.5rem 1.35rem 1.35rem;
  }

  .wd-price-card.featured {
    border: 2px solid var(--coral);
    box-shadow: 0 14px 36px rgba(15, 44, 76, 0.1);
  }

  .wd-price-badge {
    position: absolute;
    top: -0.85rem;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    background: var(--coral);
    color: var(--white);
    font-family: var(--font-heading);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .wd-price-card h3 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
  }

  .wd-price-amount {
    margin: 1rem 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem;
  }

  .wd-price-amount strong {
    font-family: var(--font-heading);
    font-size: 1.85rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--navy);
  }

  .wd-price-amount span {
    color: var(--muted-blue);
    font-size: 0.95rem;
  }

  .wd-price-desc {
    margin: 1rem 0 0;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--body-muted);
  }

  .wd-price-features {
    list-style: none;
    margin: 1.35rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
    flex: 1;
    font-size: 0.9rem;
    color: var(--body-muted);
  }

  .wd-price-features li {
    display: flex;
    gap: 0.55rem;
    align-items: flex-start;
  }

  .wd-price-check {
    color: var(--coral);
    font-weight: 700;
    line-height: 1.3;
  }

  .wd-price-cta {
    margin-top: 1.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    text-align: center;
    text-decoration: none;
    border-radius: var(--radius-sm);
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.85rem 1rem;
    background: var(--navy);
    color: var(--white);
    border: 1px solid var(--navy);
    transition: background 0.15s, border-color 0.15s;
  }

  .wd-price-cta:hover {
    background: #0b223b;
    border-color: #0b223b;
  }

  .wd-price-cta.primary {
    background: var(--button-red);
    border-color: var(--button-red);
  }

  .wd-price-cta.primary:hover {
    background: var(--button-red-hover);
    border-color: var(--button-red-hover);
  }

  .wd-price-cta:focus-visible {
    outline: 2px solid var(--coral);
    outline-offset: 2px;
  }

  .wd-pricing-footnote {
    margin: 2rem auto 0;
    max-width: 44rem;
    text-align: center;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--muted-blue);
  }

  .wd-pricing-shared {
    margin-top: clamp(2rem, 4vw, 2.75rem);
    padding: clamp(1.5rem, 3vw, 2rem);
    background: var(--white);
    border: 1px solid rgba(15, 44, 76, 0.12);
    border-radius: var(--radius-md);
  }

  .wd-pricing-shared-title {
    margin: 0 0 1.25rem;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .wd-pricing-shared-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }

  .wd-pricing-shared-list p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--body-muted);
  }

  .wd-pricing-shared-item-title {
    margin: 0 0 0.35rem;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.35;
    color: var(--navy);
  }

  @media (min-width: 860px) {
    .wd-pricing-shared-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem 2rem;
    }
  }

  .wd-after {
    display: grid;
    gap: 1.25rem;
    padding-block: clamp(2.5rem, 5vw, 3.75rem);
  }

  .wd-after-head h2 {
    font-size: clamp(1.85rem, 3.6vw, 2.55rem);
    line-height: 1.15;
    margin: 0;
    max-width: none;
  }

  .wd-after-body {
    display: grid;
    gap: 1rem;
    max-width: 62rem;
  }

  .wd-after-body p {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--navy);
  }

  .wd-included {
    display: grid;
    gap: 0.75rem 2.5rem;
    margin: 0.5rem 0 0;
    padding: 1.25rem 0 0;
    border-top: 1px solid rgba(15, 44, 76, 0.14);
    list-style: none;
    color: var(--navy);
    font-size: 1.015rem;
    line-height: 1.55;
  }

  .wd-included li {
    position: relative;
    padding-left: 1.15rem;
  }

  .wd-included li::before {
    content: '';
    position: absolute;
    top: 0.55em;
    left: 0;
    width: 0.45rem;
    height: 0.45rem;
    background: var(--button-red);
  }

  @media (min-width: 720px) {
    .wd-included {
