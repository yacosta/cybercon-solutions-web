---
import { localePath, type Messages } from '../i18n';

interface Props {
  locale: 'en' | 'es';
  t: Messages;
}

const { t } = Astro.props;
---

<section class="trust-strip" aria-label={t.trust.eyebrow}>
  <div class="container">
    <ul class="trust-list">
      {t.trust.items.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .trust-strip {
    background: var(--navy);
    color: var(--white);
    padding: 0.95rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .trust-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.35rem;
    justify-content: center;
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    line-height: 1.35;
    color: rgba(255, 255, 255, 0.88);
  }

  .trust-list li {
    position: relative;
  }

  .trust-list li:not(:last-child)::after {
    content: '·';
    position: absolute;
    right: -0.75rem;
    color: rgba(255, 255, 255, 0.35);
  }

  @media (max-width: 720px) {
    .trust-list {
      justify-content: flex-start;
      gap: 0.45rem 1rem;
    }

    .trust-list li:not(:last-child)::after {
      display: none;
    }
  }
</style>
