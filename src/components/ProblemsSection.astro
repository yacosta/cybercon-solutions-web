---
import type { Messages } from '../i18n';
import { problemPostLinks } from '../data/problem-post-links';
import { blogPath, getPublishedPost, type BlogLocale } from '../lib/blog';

interface Props {
  locale: BlogLocale;
  t: Messages;
}

const { locale, t } = Astro.props;

const items = await Promise.all(
  t.problems.items.map(async (item, index) => {
    const mapping = problemPostLinks[index] ?? null;
    if (!mapping) return { ...item, link: null as null | { href: string; label: string } };

    const post = await getPublishedPost(mapping.slug, locale);
    if (!post || post.data.customerIndustry) {
      return { ...item, link: null as null | { href: string; label: string } };
    }

    return {
      ...item,
      link: {
        href: blogPath(locale, mapping.slug),
        label: `${mapping.label[locale]} →`,
      },
    };
  }),
);
---

<section class="problems" aria-labelledby="problems-title">
  <div class="container">
    <p class="eyebrow">{t.problems.eyebrow}</p>
    <h2 id="problems-title">{t.problems.title}</h2>
    <p class="lede">{t.problems.lede}</p>
    <ul class="problem-grid">
      {items.map((item) => (
        <li>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
          {item.link && (
            <a class="problem-insight" href={item.link.href}>{item.link.label}</a>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .problems {
    background:
      radial-gradient(ellipse 55% 50% at 0% 0%, rgba(192, 57, 43, 0.06), transparent 55%),
      var(--cream);
    padding: var(--section-pad-y) 0;
  }

  .problems h2 {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    margin: 0.5rem 0 0.75rem;
    color: var(--navy);
    max-width: 22ch;
  }

  .lede {
    color: var(--body-muted);
    max-width: 40rem;
    margin: 0 0 2rem;
  }

  .problem-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem 1.5rem;
  }

  .problem-grid h3 {
    margin: 0 0 0.4rem;
    font-size: 1.05rem;
    color: var(--navy);
  }

  .problem-grid p {
    margin: 0;
    color: var(--body-muted);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .problem-insight {
    display: inline-block;
    margin-top: 0.65rem;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--navy);
    text-decoration: underline;
    text-underline-offset: 0.12em;
  }

  .problem-insight:hover {
    color: var(--coral);
  }

  @media (max-width: 900px) {
    .problem-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .problem-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
