---
import type { Messages } from '../i18n';

interface Props {
  t: Messages;
}

const { t } = Astro.props;
---

<section class="problems" aria-labelledby="problems-title">
  <div class="container">
    <p class="eyebrow">{t.problems.eyebrow}</p>
    <h2 id="problems-title">{t.problems.title}</h2>
    <p class="lede">{t.problems.lede}</p>
    <ul class="problem-grid">
      {t.problems.items.map((item) => (
        <li>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .problems {
    background:
      radial-gradient(ellipse 55% 50% at 0% 0%, rgba(192, 57, 43, 0.06), transparent 55%),
      var(--cream);
    padding: var(--section-pad-y) 0;
  }

  .problems h2 {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    margin: 0.5rem 0 0.75rem;
    color: var(--navy);
    max-width: 22ch;
  }

  .lede {
    color: var(--body-muted);
    max-width: 40rem;
    margin: 0 0 2rem;
  }

  .problem-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem 1.5rem;
  }

  .problem-grid h3 {
    margin: 0 0 0.4rem;
    font-size: 1.05rem;
    color: var(--navy);
  }

  .problem-grid p {
    margin: 0;
    color: var(--body-muted);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  @media (max-width: 900px) {
    .problem-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .problem-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
