---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import type { Industry } from '../data/industries';
import { industryPath } from '../data/industries';
import { getMessages, localePath } from '../i18n';
import { faqPageJsonLd, jsonLdScript, webPageJsonLd } from '../lib/seo';

interface Props {
  locale: 'en' | 'es';
  industry: Industry;
}

const { locale, industry } = Astro.props;
const t = getMessages(locale);
const path = industryPath(locale, industry.slug);
const homePath = localePath(locale, '/');
const industriesIndex = industryPath(locale);
const assessmentHref = localePath(locale, '/assessment/');
const overviewParas = industry.overview[locale].split(/\n\n+/).filter(Boolean);
---

<BaseLayout
  locale={locale}
  title={industry.metaTitle[locale]}
  description={industry.metaDescription[locale]}
  path={path}
  breadcrumbs={[
    { name: locale === 'es' ? 'Inicio' : 'Home', path: homePath },
    { name: t.nav.industries, path: industriesIndex },
    { name: industry.title[locale], path },
  ]}
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={jsonLdScript(
        webPageJsonLd({
          name: industry.metaTitle[locale],
          description: industry.metaDescription[locale],
          path,
          locale,
        }),
      )}
    />
    {
      industry.faqs.length > 0 && (
        <script
          type="application/ld+json"
          set:html={jsonLdScript(
            faqPageJsonLd(
              industry.faqs.map((faq) => ({
                question: faq.question,
                answer: faq.answer,
              })),
              locale,
            ),
          )}
        />
      )
    }
  </Fragment>

  <Header slot="header" locale={locale} t={t} variant="light" />

  <article class="industry-page container page" data-pagefind-body>
    <header class="industry-hero">
      <p class="eyebrow">{t.nav.industries}</p>
      <h1>{industry.title[locale]}</h1>
      <p class="lede">{industry.lede[locale]}</p>
      <div class="industry-actions">
        <a class="btn btn-primary" href={assessmentHref}>{t.servicePage.cta}</a>
        <a class="text-link" href={industriesIndex}>{t.industries.allIndustries}</a>
      </div>
    </header>

    <section class="industry-block" aria-labelledby="industry-overview">
      <h2 id="industry-overview">{t.industries.overviewTitle}</h2>
      {overviewParas.map((paragraph) => <p>{paragraph}</p>)}
    </section>

    <section class="industry-block" aria-labelledby="industry-challenges">
      <h2 id="industry-challenges">{industry.challengesLabel[locale]}</h2>
      <ul class="challenge-list">
        {industry.challenges.map((item) => <li>{item[locale]}</li>)}
      </ul>
    </section>

    <section class="industry-block" aria-labelledby="industry-help">
      <h2 id="industry-help">{industry.helpLabel[locale]}</h2>
      <ul class="help-list">
        {
          industry.help.map((item) => (
            <li>
              <h3>{item.title[locale]}</h3>
              <p>{item.body[locale]}</p>
            </li>
          ))
        }
      </ul>
    </section>

    {
      industry.faqs.length > 0 && (
        <section class="industry-block" aria-labelledby="industry-faq">
          <h2 id="industry-faq">{t.servicePage.faqTitle}</h2>
          <dl class="faq-list">
            {industry.faqs.map((faq) => (
              <div class="faq-row">
                <dt>{faq.question[locale]}</dt>
                <dd>{faq.answer[locale]}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    <section class="industry-cta" aria-labelledby="industry-cta-title">
      <h2 id="industry-cta-title">{t.servicePage.ctaTitle}</h2>
      <p>{t.servicePage.ctaBody}</p>
      <a class="btn btn-primary" href={assessmentHref}>{t.servicePage.cta}</a>
    </section>
  </article>

  <Footer slot="footer" locale={locale} t={t} />
</BaseLayout>

<style>
  .industry-hero {
    margin-bottom: 0.5rem;
  }

  .industry-hero h1 {
    margin: 0.5rem 0 0.85rem;
    font-size: clamp(2rem, 4vw, 2.75rem);
    color: var(--navy);
    max-width: 18ch;
  }

  .industry-hero .lede {
    margin: 0 0 1.5rem;
    max-width: 38rem;
    color: var(--body-muted);
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  .industry-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.35rem;
    align-items: center;
  }

  .text-link {
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--button-red);
    text-decoration: none;
  }

  .text-link:hover,
  .text-link:focus-visible {
    text-decoration: underline;
  }

  .industry-block {
    padding-block: 1.75rem;
    border-top: 1px solid rgba(15, 44, 76, 0.12);
  }

  .industry-block h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.25rem, 2.2vw, 1.5rem);
    color: var(--navy);
  }

  .industry-block > p {
    margin: 0 0 1rem;
    max-width: 42rem;
    color: var(--body-muted);
    line-height: 1.65;
  }

  .challenge-list {
    margin: 0;
    padding-left: 1.15rem;
    max-width: 40rem;
    color: var(--body-muted);
  }

  .challenge-list li + li {
    margin-top: 0.55rem;
  }

  .help-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 800px) {
    .help-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem 2rem;
    }
  }

  .help-list h3 {
    margin: 0 0 0.4rem;
    font-size: 1.05rem;
    color: var(--navy);
  }

  .help-list p {
    margin: 0;
    color: var(--body-muted);
    font-size: 0.975rem;
    line-height: 1.55;
  }

  .faq-list {
    margin: 0;
  }

  .faq-row {
    padding-block: 1rem;
    border-top: 1px solid rgba(15, 44, 76, 0.1);
  }

  .faq-row:last-child {
    border-bottom: 1px solid rgba(15, 44, 76, 0.1);
  }

  .faq-row dt {
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--navy);
    margin-bottom: 0.35rem;
  }

  .faq-row dd {
    margin: 0;
    max-width: 40rem;
    color: var(--body-muted);
    line-height: 1.55;
  }

  .industry-cta {
    margin-top: 1.5rem;
    padding: clamp(1.75rem, 4vw, 2.5rem);
    background: var(--navy);
    color: var(--white);
    border-radius: var(--radius-md);
  }

  .industry-cta h2 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
  }

  .industry-cta p {
    margin: 0 0 1.25rem;
    color: var(--secondary-dark);
    max-width: 32rem;
  }
</style>
