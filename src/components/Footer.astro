---
import Wordmark from './Wordmark.astro';
import { localePath, type Messages } from '../i18n';
import { site } from '../lib/site';
import { services, servicePath } from '../data/services';
import { industries, industryPath } from '../data/industries';

interface Props {
  locale: string;
  t: Messages;
}

const { locale, t } = Astro.props;
const loc = locale === 'es' ? 'es' : 'en';
const homeHref = localePath(locale, '/');
const assessmentHref = localePath(locale, '/assessment/');
const newWindowHint = locale === 'es' ? '(se abre en una pestaña nueva)' : '(opens in a new tab)';
const heartLabel = locale === 'es' ? 'cariño' : 'love';

const serviceGroups = [
  ['managed-it', 'cybersecurity', 'backup-disaster-recovery', 'it-consulting'],
  ['ai-security', 'ai-consulting', 'ai-integration', 'conversational-ai'],
  ['cloud', 'web-design-development'],
] as const;

const serviceLinkGroups = serviceGroups.map((slugs) =>
  slugs
    .map((slug) => services.find((service) => service.slug === slug))
    .filter((service): service is (typeof services)[number] => Boolean(service))
    .map((service) => ({
      href: servicePath(locale, service.slug),
      title: service.title[loc],
    })),
);

const industryLinks = industries.map((industry) => ({
  href: industryPath(locale, industry.slug),
  title: industry.title[loc],
}));

const addressLines =
  loc === 'es'
    ? [site.legalName, site.address.street, `${site.address.locality}, ${site.address.region} ${site.address.postalCode}`]
    : [site.legalName, site.address.street, `${site.address.locality}, ${site.address.region} ${site.address.postalCode}`];
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-grid">
      <div class="footer-brand">
        <Wordmark variant="dark" href={homeHref} homeLabel={t.nav.homeAria} />
        <p class="footer-blurb">{t.footer.blurb}</p>
        <ul class="footer-contact-list">
          <li>
            <span class="footer-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75">
                <path d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11Z"></path>
                <circle cx="12" cy="10" r="2.5"></circle>
              </svg>
            </span>
            <span>
              {
                addressLines.map((line, index) => (
                  <>
                    {index === 0 ? <strong>{line}</strong> : line}
                    {index < addressLines.length - 1 && <br />}
                  </>
                ))
              }
              <br />
              <span class="footer-mailing-note">{t.footer.mailing}</span>
            </span>
          </li>
          <li>
            <span class="footer-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75">
                <path
                  d="M6.5 4.5h2.2l1.1 3.2-1.4 1.4a12.5 12.5 0 0 0 6.5 6.5l1.4-1.4 3.2 1.1v2.2c0 .8-.7 1.5-1.5 1.5A14.5 14.5 0 0 1 5 6c0-.8.7-1.5 1.5-1.5Z"
                ></path>
              </svg>
            </span>
            <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a>
          </li>
          <li>
            <span class="footer-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75">
                <rect x="3.5" y="5.5" width="17" height="13" rx="2"></rect>
                <path d="m4.5 7.5 7.5 6 7.5-6"></path>
              </svg>
            </span>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
        </ul>
      </div>

      <nav class="footer-col" aria-labelledby="footer-services-heading">
        <h2 id="footer-services-heading" class="footer-heading">{t.footer.servicesHeading}</h2>
        {
          serviceLinkGroups.map((group, groupIndex) => (
            <>
              {groupIndex > 0 && <hr class="footer-rule" />}
              <ul class="footer-links">
                {group.map((link) => (
                  <li>
                    <a href={link.href}>{link.title}</a>
                  </li>
                ))}
              </ul>
            </>
          ))
        }
      </nav>

      <nav class="footer-col" aria-labelledby="footer-industries-heading">
        <h2 id="footer-industries-heading" class="footer-heading">{t.footer.industriesHeading}</h2>
        <ul class="footer-links">
          {
            industryLinks.map((link) => (
              <li>
                <a href={link.href}>{link.title}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="footer-col">
        <h2 id="footer-areas-heading" class="footer-heading">{t.footer.areasHeading}</h2>
        <ul class="footer-links footer-areas" aria-labelledby="footer-areas-heading">
          {t.footer.areas.map((area) => <li>{area}</li>)}
        </ul>
        <a class="footer-cta" href={assessmentHref}>{t.footer.cta}</a>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copy">
        {t.footer.copyright}
        <span class="divider" aria-hidden="true">|</span>
        <span class="footer-made">
          {t.footer.madeWith}
          {' '}
          <span class="heart" role="img" aria-label={heartLabel}>&#10084;</span>
          {' '}
          {t.footer.madeWithPlace}
        </span>
      </p>
      <div class="footer-social">
        <a
          class="footer-social-link"
          href={site.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="visually-hidden">LinkedIn {newWindowHint}</span>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="currentColor">
            <path
              d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.24 8.25h4.52V24H.24V8.25zM8.34 8.25h4.33v2.14h.06c.6-1.14 2.08-2.34 4.28-2.34 4.58 0 5.42 3.01 5.42 6.93V24h-4.52v-6.86c0-1.64-.03-3.75-2.29-3.75-2.29 0-2.64 1.79-2.64 3.63V24H8.34V8.25z"
            ></path>
          </svg>
        </a>
        <a
          class="footer-social-link"
          href={site.social.x}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="visually-hidden">X {newWindowHint}</span>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor">
            <path
              d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
            ></path>
          </svg>
        </a>
      </div>
      <p class="footer-legal">
        <a href={localePath(locale, '/about/')}>{t.footer.about}</a>
        <span class="divider" aria-hidden="true">|</span>
        <a href={localePath(locale, '/privacy/')}>{t.footer.privacy}</a>
        <span class="divider" aria-hidden="true">|</span>
        <a href={localePath(locale, '/accessibility/')}>{t.footer.accessibility}</a>
        <span class="divider" aria-hidden="true">|</span>
        <a href={localePath(locale, '/terms/')}>{t.footer.terms}</a>
        <span class="divider" aria-hidden="true">|</span>
        <a href="/sitemap.txt">{t.footer.sitemap}</a>
        <span class="divider" aria-hidden="true">|</span>
        <button type="button" class="cookie-reset" data-cookie-settings>
          {t.footer.cookies}
        </button>
        <span class="divider" aria-hidden="true">|</span>
        <a href="/.well-known/cats.txt">cats.txt</a>
      </p>
    </div>
  </div>
</footer>

<script>
  document.querySelector('[data-cookie-settings]')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('cybercon:cookie-settings'));
  });
</script>

<style>
  .site-footer {
    background: var(--navy);
    color: #b6c7d6;
    padding: 4.5rem var(--page-inline) 1.75rem;
  }

  .footer-inner {
    display: grid;
    gap: 2.5rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(220px, 1.2fr) repeat(3, minmax(140px, 1fr));
    gap: 2.25rem 2rem;
    align-items: start;
  }

  .footer-brand {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }

  .footer-brand :global(.wordmark .name),
  .footer-brand :global(.wordmark .sub) {
    font-size: 1.125rem;
  }

  .footer-blurb {
    margin: 0;
    max-width: 38ch;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.5;
    color: #b6c7d6;
  }

  .footer-contact-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }

  .footer-contact-list li {
    display: grid;
    grid-template-columns: 1.35rem 1fr;
    gap: 0.7rem;
    align-items: start;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: #b6c7d6;
  }

  .footer-contact-list strong {
    color: var(--white);
    font-weight: 700;
  }

  .footer-mailing-note {
    display: inline-block;
    margin-top: 0.35rem;
    font-size: 0.8125rem;
    font-style: italic;
    color: rgba(182, 199, 214, 0.85);
  }

  .footer-icon {
    display: inline-flex;
    margin-top: 0.15rem;
    color: #b6c7d6;
  }

  .footer-heading {
    margin: 0 0 0.9rem;
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--white);
  }

  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  .footer-links a,
  .footer-contact-list a {
    color: #b6c7d6;
    text-decoration: underline;
    text-underline-offset: 0.15em;
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.45;
  }

  .footer-legal a,
  .cookie-reset {
    color: #b6c7d6;
    text-decoration: underline;
    text-underline-offset: 0.15em;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.5;
  }

  .footer-areas li {
    color: #b6c7d6;
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.45;
  }

  .footer-rule {
    border: 0;
    border-top: 1px solid rgba(182, 199, 214, 0.22);
    margin: 0.95rem 0;
  }

  .footer-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 1.5rem;
    padding: 0.85rem 1.25rem;
    border-radius: 999px;
    background: var(--button-red);
    color: var(--white);
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    min-height: 44px;
  }

  .footer-cta:hover {
    background: var(--button-red-hover);
  }

  .footer-bottom {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto max-content;
    gap: 1rem;
    align-items: center;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(182, 199, 214, 0.22);
  }

  .footer-copy,
  .footer-legal {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.5;
    color: #b6c7d6;
  }

  .footer-made {
    white-space: nowrap;
  }

  .heart {
    color: var(--coral);
    display: inline-block;
    font-size: 1.35em;
    line-height: 1;
    vertical-align: -0.05em;
    transform-origin: center;
    /* Same idea as MediaNV’s footer heart: scale pulse, alternate forever */
    animation: heart-pulse 1.5s ease-in infinite alternate;
  }

  @keyframes heart-pulse {
    0% {
      transform: scale(0.55);
    }

    100% {
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .heart {
      animation: none;
    }
  }

  .footer-legal {
    justify-self: end;
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: flex-end;
    white-space: nowrap;
  }

  .footer-social {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
  }

  .footer-social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--white);
    text-decoration: none;
  }

  .footer-social-link:hover {
    color: var(--cream);
  }

  .divider {
    color: rgba(182, 199, 214, 0.55);
    margin: 0 0.45rem;
  }

  .cookie-reset {
    display: inline-flex;
    align-items: center;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    min-height: 44px;
  }

  .site-footer a:hover,
  .cookie-reset:hover {
    color: var(--cream);
  }

  .footer-cta:hover {
    color: var(--white);
  }

  .cookie-reset:focus-visible,
  .site-footer a:focus-visible {
    outline: 2px solid var(--coral);
    outline-offset: 3px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 960px) {
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 720px) {
    .site-footer {
      padding-top: 3rem;
      padding-bottom: 1.5rem;
    }

    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer-brand {
      grid-column: auto;
    }

    .footer-blurb {
      max-width: none;
    }

    .footer-cta {
      width: 100%;
    }

    .footer-bottom {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      gap: 0.85rem;
    }

    .footer-legal {
      justify-self: center;
      flex-wrap: wrap;
      justify-content: center;
      white-space: normal;
      gap: 0.35rem 0;
    }

    .footer-legal .divider {
      margin: 0 0.4rem;
    }
  }
</style>
