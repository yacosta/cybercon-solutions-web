---
/**
 * Contact page — Nicepage-style two-column block (headline left, rounded
 * quotation form card right), restyled in Cybercon navy / coral / cream.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { getMessages, localePath } from '../i18n';
import { turnstileSiteKey } from '../lib/turnstile';
import { formatMailingAddress, site } from '../lib/site';
import { contactPageJsonLd, jsonLdScript } from '../lib/seo';

interface Props {
  locale: 'en' | 'es';
}

const { locale } = Astro.props;
const t = getMessages(locale);
const c = t.contact;
const siteKey = turnstileSiteKey();
const privacyHref = localePath(locale, '/privacy/');
const assessmentHref = localePath(locale, '/assessment/');
const siteCheckHref = `${localePath(locale, '/services/web-design-development/')}#site-check`;
const path = localePath(locale, '/contact/');
const homePath = localePath(locale, '/');
const mailingAddress = formatMailingAddress();
---

<BaseLayout
  locale={locale}
  title={c.metaTitle}
  description={c.description}
  path={path}
  breadcrumbs={[
    { name: locale === 'es' ? 'Inicio' : 'Home', path: homePath },
    { name: c.title, path },
  ]}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonLdScript(contactPageJsonLd({
      name: c.metaTitle,
      description: c.description,
      path,
      locale,
    }))} />
  </Fragment>
  <Header slot="header" locale={locale} t={t} variant="light" />

  <!-- contact-layout-v2: nicepage two-column -->
  <section class="contact-page" aria-labelledby="contact-title" data-pagefind-body>
    <div class="contact-atmosphere" aria-hidden="true"></div>

    <div class="container contact-grid">
      <div class="contact-copy">
        <p class="eyebrow contact-reveal">{c.eyebrow}</p>
        <h1 id="contact-title" class="contact-reveal contact-reveal-delay-1">{c.heading}</h1>
        <p class="lede contact-reveal contact-reveal-delay-2">{c.lede}</p>
        <div class="contact-actions contact-reveal contact-reveal-delay-2">
          <a class="btn btn-primary" href={assessmentHref}>{c.assessmentCta}</a>
          <a class="contact-text-link" href={siteCheckHref}>{c.siteCheckCta}</a>
        </div>
        <p class="site-check-hint contact-reveal contact-reveal-delay-3">{c.siteCheckLede}</p>
        <p class="contact-inline contact-reveal contact-reveal-delay-3">
          <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a>
          <span aria-hidden="true">·</span>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
        <p class="contact-local contact-reveal contact-reveal-delay-3">
          <span>{c.areaLabel}: {site.serviceAreaFocus}</span>
          <span aria-hidden="true">·</span>
          <span>{c.mailingLabel}: {mailingAddress}</span>
        </p>
      </div>

      <div class="contact-card contact-reveal contact-reveal-delay-2">
        <h2 class="card-title">{c.formTitle}</h2>

        <form id="contact-form" class="contact-form" novalidate>
          <div class="field">
            <label for="contact-name">{c.name}</label>
            <input
              id="contact-name"
              name="name"
              type="text"
              required
              autocomplete="name"
              placeholder={c.namePlaceholder}
            />
          </div>

          <div class="field">
            <label for="contact-email">{c.email}</label>
            <input
              id="contact-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder={c.emailPlaceholder}
            />
          </div>

          <div class="field">
            <label for="contact-message">{c.message}</label>
            <textarea
              id="contact-message"
              name="message"
              rows="4"
              required
              placeholder={c.messagePlaceholder}
            ></textarea>
          </div>

          <input type="hidden" name="company" value="" />

          <label class="agree">
            <input id="contact-agree" name="agree" type="checkbox" required />
            <span>
              {c.agreePrefix}
              {' '}
              <a href={privacyHref}>{c.agreeLink}</a>
              {c.agreeSuffix}
            </span>
          </label>

          {siteKey && (
            <div class="turnstile-wrap">
              <div class="cf-turnstile" data-sitekey={siteKey} data-theme="light"></div>
            </div>
          )}

          <p class="form-error" id="contact-error" hidden role="alert" aria-live="assertive"></p>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary">{c.submit}</button>
          </div>
        </form>

        <div id="contact-thanks" class="thanks" hidden role="status" aria-live="polite" tabindex="-1">
          <div class="check" aria-hidden="true">✓</div>
          <h2>{c.thanksTitle}</h2>
          <p>{c.thanksBody}</p>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" locale={locale} t={t} />
</BaseLayout>

{siteKey && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script define:vars={{ locale, messages: c, requireTurnstile: Boolean(siteKey) }}>
  const form = document.getElementById('contact-form');
  const thanks = document.getElementById('contact-thanks');
  const errorEl = document.getElementById('contact-error');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement) || !thanks || !errorEl) return;

    errorEl.hidden = true;
    const data = new FormData(form);
    const agree = form.querySelector('#contact-agree');
    if (agree instanceof HTMLInputElement && !agree.checked) {
      errorEl.textContent = messages.agreeError;
      errorEl.hidden = false;
      return;
    }

    const turnstile = form.querySelector('[name="cf-turnstile-response"]');
    const turnstileToken = turnstile instanceof HTMLInputElement ? turnstile.value : '';

    if (requireTurnstile && !turnstileToken) {
      errorEl.textContent = messages.turnstileError;
      errorEl.hidden = false;
      return;
    }

    const attribution = window.cyberconAttribution?.get?.() ?? undefined;

    window.cyberconAttribution?.track?.('contact_submitted');

    let response;
    try {
      response = await fetch('/api/contact/', {
        method: 'POST',
        headers: { 'content-type': 'application/json', accept: 'application/json' },
        body: JSON.stringify({
          name: String(data.get('name') ?? ''),
          company: String(data.get('company') ?? ''),
          email: String(data.get('email') ?? ''),
          message: String(data.get('message') ?? ''),
          locale,
          turnstileToken,
          attribution,
        }),
      });
    } catch {
      window.cyberconAttribution?.track?.('contact_delivery_failed', { status: 0 });
      errorEl.textContent = messages.error;
      errorEl.hidden = false;
      return;
    }

    if (!response.ok) {
      window.cyberconAttribution?.track?.('contact_delivery_failed', { status: response.status });
      errorEl.textContent = messages.error;
      errorEl.hidden = false;
      return;
    }

    window.cyberconAttribution?.track?.('contact_delivery_success');

    form.hidden = true;
    thanks.hidden = false;
    thanks.focus();
  });
</script>

<style>
  .contact-page {
    position: relative;
    isolation: isolate;
    min-height: calc(100vh - 7.5rem);
    display: flex;
    align-items: center;
    padding: clamp(3rem, 7vw, 5.5rem) 0;
    overflow: hidden;
    background: var(--cream);
  }

  .contact-atmosphere {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse 60% 55% at 8% 30%, rgba(192, 57, 43, 0.14), transparent 58%),
      radial-gradient(ellipse 50% 60% at 92% 75%, rgba(15, 44, 76, 0.07), transparent 62%),
      linear-gradient(160deg, #fcfaf8 0%, var(--cream) 45%, #eef3f7 100%);
  }

  /*
   * Contact-only width: a touch wider than the site --page-max so side
   * margins match the Nicepage reference. Must beat the shared .container
   * rule — do not use width:100% here or the grid goes full-bleed.
   */
  .contact-page .contact-grid.container {
    box-sizing: border-box;
    width: min(1280px, calc(100% - 2.5rem));
    max-width: none;
    margin-inline: auto;
    padding-inline: 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(1.75rem, 4vw, 3.25rem);
    align-items: center;
  }

  .contact-copy .eyebrow {
    margin: 0 0 1rem;
    color: var(--coral);
  }

  .contact-copy h1 {
    margin: 0 0 1.15rem;
    font-size: clamp(2.25rem, 5vw, 3.35rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--navy);
    max-width: 18ch;
  }

  .contact-copy .lede {
    margin: 0 0 1.25rem;
    max-width: 34rem;
    color: var(--body-muted);
    font-size: 1.0625rem;
    font-weight: 400;
    line-height: 1.7;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem 1.25rem;
    margin: 0 0 0.65rem;
  }

  .contact-text-link {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--button-red);
    text-decoration: none;
  }

  .contact-text-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .site-check-hint {
    margin: 0 0 1.25rem;
    max-width: 34rem;
    font-size: 0.9rem;
    color: var(--muted-blue);
  }

  .contact-inline {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 0.75rem;
    align-items: center;
    font-size: 0.95rem;
    color: var(--muted-blue);
  }

  .contact-inline a {
    color: var(--navy);
    text-decoration: none;
    font-weight: 500;
  }

  .contact-inline a:hover {
    color: var(--coral);
  }

  .contact-local {
    margin: 0.85rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.75rem;
    align-items: baseline;
    max-width: 34rem;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--muted-blue);
  }

  .contact-card {
    background: var(--white);
    border-radius: 1.875rem;
    padding: clamp(1.75rem, 3.5vw, 2.5rem);
    border: 1px solid rgba(15, 44, 76, 0.06);
    box-shadow:
      0 1px 0 rgba(15, 44, 76, 0.03),
      0 22px 48px rgba(15, 44, 76, 0.09);
  }

  .card-title {
    margin: 0 0 1.35rem;
    font-size: clamp(1.25rem, 2.2vw, 1.55rem);
    line-height: 1.25;
    color: var(--navy);
  }

  .contact-form {
    display: grid;
    gap: 1.05rem;
  }

  .contact-form .field input,
  .contact-form .field textarea {
    width: 100%;
    border: 2px solid rgba(15, 44, 76, 0.08);
    border-radius: 0.65rem;
    background: #eef1f4;
    color: var(--navy);
    font: inherit;
    padding: 0.9rem 1rem;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease,
      background 0.15s ease;
  }

  .contact-form .field textarea {
    min-height: 7.5rem;
    resize: vertical;
  }

  .contact-form .field input::placeholder,
  .contact-form .field textarea::placeholder {
    color: var(--placeholder);
  }

  .contact-form .field input:focus,
  .contact-form .field textarea:focus {
    outline: none;
    border-color: var(--coral);
    background: var(--white);
    box-shadow: var(--shadow-focus);
  }

  .agree {
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
    font-size: 0.875rem;
    color: var(--body-muted);
    line-height: 1.45;
  }

  .agree input {
    margin-top: 0.2rem;
    width: 1rem;
    height: 1rem;
    accent-color: var(--coral);
    flex-shrink: 0;
  }

  .agree a {
    color: var(--navy);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .agree a:hover {
    color: var(--coral);
  }

  .turnstile-wrap {
    min-height: 1.5rem;
  }

  .form-error {
    margin: 0;
    color: var(--button-red);
    font-size: 0.875rem;
  }

  .form-actions {
    display: flex;
    justify-content: flex-end;
  }

  .form-actions .btn-primary {
    min-width: 11.5rem;
  }

  .contact-form[hidden],
  .thanks[hidden] {
    display: none;
  }

  .thanks:not([hidden]) {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
  }

  .thanks h2 {
    margin: 0;
    font-size: 1.35rem;
    color: var(--navy);
  }

  .thanks p {
    margin: 0;
    color: var(--body-muted);
  }

  .check {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--coral);
    display: grid;
    place-items: center;
    color: var(--white);
    font-size: 1.625rem;
    font-weight: 700;
  }

  .contact-reveal {
    opacity: 0;
    transform: translateY(16px);
    animation: contact-rise 0.75s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .contact-reveal-delay-1 {
    animation-delay: 0.08s;
  }

  .contact-reveal-delay-2 {
    animation-delay: 0.16s;
  }

  .contact-reveal-delay-3 {
    animation-delay: 0.24s;
  }

  @keyframes contact-rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-reveal {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }

  @media (max-width: 900px) {
    .contact-page {
      display: block;
      min-height: 0;
      padding-block: 2.25rem 3rem;
    }

    .contact-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .contact-copy h1 {
      max-width: none;
      font-size: clamp(2.15rem, 9vw, 3rem);
    }

    .form-actions {
      justify-content: stretch;
    }

    .form-actions .btn-primary {
      width: 100%;
    }
  }
</style>
