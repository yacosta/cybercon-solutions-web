---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { getMessages, localePath } from '../i18n';
import { turnstileSiteKey } from '../lib/turnstile';
import { formatMailingAddress, site } from '../lib/site';

interface Props {
  locale: 'en' | 'es';
}

const { locale } = Astro.props;
const t = getMessages(locale);
const c = t.contact;
const siteKey = turnstileSiteKey();
const privacyHref = localePath(locale, '/privacy/');
const path = localePath(locale, '/contact/');
const mailing = formatMailingAddress();
---

<BaseLayout
  locale={locale}
  title={`${c.title} | Cybercon`}
  description={c.description}
  path={path}
>
  <Header slot="header" locale={locale} t={t} variant="light" />

  <section class="contact-page" aria-labelledby="contact-title" data-pagefind-body>
    <div class="contact-atmosphere" aria-hidden="true"></div>
    <div class="container contact-grid">
      <div class="contact-copy">
        <p class="eyebrow contact-reveal">{c.eyebrow}</p>
        <h1 id="contact-title" class="contact-reveal contact-reveal-delay-1">{c.heading}</h1>
        <p class="lede contact-reveal contact-reveal-delay-2">{c.lede}</p>

        <ul class="contact-details contact-reveal contact-reveal-delay-3">
          <li>
            <span class="detail-label">{c.phoneLabel}</span>
            <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a>
          </li>
          <li>
            <span class="detail-label">{c.emailLabel}</span>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li>
            <span class="detail-label">{c.areaLabel}</span>
            <span>{site.serviceAreaFocus}</span>
          </li>
          <li>
            <span class="detail-label">{c.mailingLabel}</span>
            <span>{mailing}</span>
          </li>
        </ul>
      </div>

      <div class="contact-card contact-reveal contact-reveal-delay-2">
        <h2 class="card-title">{c.formTitle}</h2>
        <form id="contact-form" class="contact-form" novalidate>
          <div class="field">
            <label for="contact-name">{c.name}</label>
            <input
              id="contact-name"
              name="name"
              type="text"
              required
              autocomplete="name"
              placeholder={c.namePlaceholder}
            />
          </div>
          <div class="field">
            <label for="contact-email">{c.email}</label>
            <input
              id="contact-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder={c.emailPlaceholder}
            />
          </div>
          <div class="field">
            <label for="contact-company">
              {c.company}
              <span class="optional">{c.optional}</span>
            </label>
            <input
              id="contact-company"
              name="company"
              type="text"
              autocomplete="organization"
              placeholder={c.companyPlaceholder}
            />
          </div>
          <div class="field">
            <label for="contact-message">{c.message}</label>
            <textarea
              id="contact-message"
              name="message"
              rows="4"
              required
              placeholder={c.messagePlaceholder}
            ></textarea>
          </div>

          <label class="agree">
            <input id="contact-agree" name="agree" type="checkbox" required />
            <span>
              {c.agreePrefix}
              {' '}
              <a href={privacyHref}>{c.agreeLink}</a>
              {c.agreeSuffix}
            </span>
          </label>

          {siteKey && (
            <div class="turnstile-wrap">
              <div class="cf-turnstile" data-sitekey={siteKey} data-theme="light"></div>
            </div>
          )}

          <p class="form-error" id="contact-error" hidden role="alert" aria-live="assertive"></p>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary">{c.submit}</button>
          </div>
        </form>

        <div id="contact-thanks" class="thanks" hidden role="status" aria-live="polite" tabindex="-1">
          <div class="check" aria-hidden="true">✓</div>
          <h2>{c.thanksTitle}</h2>
          <p>{c.thanksBody}</p>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" locale={locale} t={t} />
</BaseLayout>

{siteKey && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script define:vars={{ locale, messages: c, requireTurnstile: Boolean(siteKey) }}>
  const form = document.getElementById('contact-form');
  const thanks = document.getElementById('contact-thanks');
  const errorEl = document.getElementById('contact-error');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement) || !thanks || !errorEl) return;

    errorEl.hidden = true;
    const data = new FormData(form);
    const agree = form.querySelector('#contact-agree');
    if (agree instanceof HTMLInputElement && !agree.checked) {
      errorEl.textContent = messages.agreeError;
      errorEl.hidden = false;
      return;
    }

    const turnstile = form.querySelector('[name="cf-turnstile-response"]');
    const turnstileToken = turnstile instanceof HTMLInputElement ? turnstile.value : '';

    if (requireTurnstile && !turnstileToken) {
      errorEl.textContent = messages.turnstileError;
      errorEl.hidden = false;
      return;
    }

    const response = await fetch('/api/contact', {
      method: 'POST',
      headers: { 'content-type': 'application/json', accept: 'application/json' },
      body: JSON.stringify({
        name: String(data.get('name') ?? ''),
        company: String(data.get('company') ?? ''),
        email: String(data.get('email') ?? ''),
        message: String(data.get('message') ?? ''),
        locale,
        turnstileToken,
      }),
    });

    if (!response.ok) {
      errorEl.textContent = messages.error;
      errorEl.hidden = false;
      return;
    }

    form.hidden = true;
    thanks.hidden = false;
    thanks.focus();
  });
</script>

<style>
  .contact-page {
    position: relative;
    isolation: isolate;
    min-height: calc(100vh - 8rem);
    padding: clamp(2.5rem, 6vw, 5rem) 0 clamp(3.5rem, 8vw, 6rem);
    overflow: hidden;
    background: var(--cream);
  }

  .contact-atmosphere {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse 55% 50% at 12% 20%, rgba(242, 107, 94, 0.12), transparent 58%),
      radial-gradient(ellipse 45% 55% at 88% 70%, rgba(15, 44, 76, 0.08), transparent 60%),
      linear-gradient(165deg, #fbf8f5 0%, var(--cream) 48%, #eef2f6 100%);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .contact-copy .eyebrow {
    margin-bottom: 0.85rem;
  }

  .contact-copy h1 {
    font-size: clamp(2.1rem, 4.4vw, 3.35rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
    color: var(--navy);
    max-width: 14ch;
    margin-bottom: 1.1rem;
  }

  .contact-copy .lede {
    color: var(--body-muted);
    font-size: 1.05rem;
    line-height: 1.65;
    max-width: 34rem;
    margin-bottom: 1.75rem;
  }

  .contact-details {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.95rem;
    max-width: 28rem;
  }

  .contact-details li {
    display: grid;
    gap: 0.2rem;
  }

  .detail-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted-blue);
  }

  .contact-details a,
  .contact-details span:not(.detail-label) {
    color: var(--navy);
    font-size: 1rem;
    text-decoration: none;
  }

  .contact-details a:hover {
    color: var(--coral);
  }

  .contact-card {
    background: var(--white);
    border-radius: 1.75rem;
    padding: clamp(1.5rem, 3vw, 2.15rem);
    box-shadow:
      0 1px 0 rgba(15, 44, 76, 0.04),
      0 18px 40px rgba(15, 44, 76, 0.08);
    border: 1px solid rgba(15, 44, 76, 0.06);
  }

  .card-title {
    font-size: clamp(1.2rem, 2vw, 1.45rem);
    color: var(--navy);
    margin-bottom: 1.25rem;
  }

  .contact-form {
    display: grid;
    gap: 1rem;
  }

  .contact-form .field label {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .optional {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--muted-blue);
    text-transform: none;
    letter-spacing: 0;
  }

  .contact-form textarea {
    width: 100%;
    min-height: 7rem;
    resize: vertical;
    font: inherit;
    color: var(--navy);
    background: var(--cream);
    border: 1px solid rgba(15, 44, 76, 0.14);
    border-radius: var(--radius-md);
    padding: 0.75rem 0.9rem;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .contact-form textarea:focus {
    outline: none;
    border-color: var(--coral);
    box-shadow: var(--shadow-focus);
    background: var(--white);
  }

  .contact-form input[type='text'],
  .contact-form input[type='email'] {
    background: var(--cream);
  }

  .contact-form input[type='text']:focus,
  .contact-form input[type='email']:focus {
    background: var(--white);
  }

  .agree {
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
    font-size: 0.875rem;
    color: var(--body-muted);
    line-height: 1.45;
  }

  .agree input {
    margin-top: 0.2rem;
    width: 1rem;
    height: 1rem;
    accent-color: var(--coral);
    flex-shrink: 0;
  }

  .agree a {
    color: var(--navy);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .agree a:hover {
    color: var(--coral);
  }

  .turnstile-wrap {
    min-height: 1.5rem;
  }

  .form-error {
    color: var(--button-red);
    font-size: 0.875rem;
    margin: 0;
  }

  .form-actions {
    display: flex;
    justify-content: flex-end;
  }

  .form-actions .btn-primary {
    min-width: 12rem;
  }

  .contact-form[hidden],
  .thanks[hidden] {
    display: none;
  }

  .thanks:not([hidden]) {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
  }

  .thanks h2 {
    font-size: 1.35rem;
    color: var(--navy);
  }

  .thanks p {
    margin: 0;
    color: var(--body-muted);
  }

  .check {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--coral);
    display: grid;
    place-items: center;
    color: var(--white);
    font-size: 1.625rem;
    font-weight: 700;
  }

  .contact-reveal {
    opacity: 0;
    transform: translateY(14px);
    animation: contact-rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .contact-reveal-delay-1 {
    animation-delay: 0.08s;
  }

  .contact-reveal-delay-2 {
    animation-delay: 0.16s;
  }

  .contact-reveal-delay-3 {
    animation-delay: 0.24s;
  }

  @keyframes contact-rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-reveal {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
      align-items: start;
    }

    .contact-copy h1 {
      max-width: none;
    }

    .form-actions {
      justify-content: stretch;
    }

    .form-actions .btn-primary {
      width: 100%;
    }
  }
</style>
