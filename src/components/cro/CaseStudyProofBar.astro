---
import type { Messages } from '../../i18n';
import { getCustomerStoryGroups } from '../../lib/blog';

interface Props {
  locale: 'en' | 'es';
  t: Messages;
  variant?: 'v1' | 'v2';
}

const { locale, t, variant = 'v1' } = Astro.props;
const copy = t.cro.caseStudyProof;
const storyCopy = copy.stories;

type ProofItem = {
  industryId: string;
  industryLabel: string;
  slug: string;
  title: string;
  href: string;
  stat: string;
  badge: string;
  linkText: string;
};

const groups = await getCustomerStoryGroups(locale);
const items: ProofItem[] = [];

for (const group of groups) {
  const papers = group.papers;
  if (papers.length === 0) continue;

  let selected = papers[0];
  for (const paper of papers) {
    const slug = paper.href.replace(/^\/(?:es\/)?blog\//, '').replace(/\/$/, '');
    if (slug in storyCopy) {
      selected = paper;
      if (
        group.industry.id === 'healthcare' &&
        slug === 'healthcare-nonprofit-it-transformation-case-study'
      ) {
        break;
      }
      if (group.industry.id !== 'healthcare') break;
    }
  }

  const slug = selected.href.replace(/^\/(?:es\/)?blog\//, '').replace(/\/$/, '');
  const curated = storyCopy[slug as keyof typeof storyCopy];
  if (!curated) continue;

  items.push({
    industryId: group.industry.id,
    industryLabel: group.industry.label[locale],
    slug,
    title: selected.title,
    href: selected.href,
    stat: curated.stat,
    badge: curated.badge,
    linkText: curated.linkText,
  });
}

const defaultIndex = (() => {
  const healthcare = items.findIndex((item) => item.industryId === 'healthcare');
  return healthcare >= 0 ? healthcare : 0;
})();

const panelId = (id: string) => `case-study-proof-panel-${variant}-${id}`;
const tabId = (id: string) => `case-study-proof-tab-${variant}-${id}`;
const titleId = `case-study-proof-title-${variant}`;
---

{
  items.length > 0 && (
    <section
      class:list={['case-study-proof', `case-study-proof--${variant}`]}
      data-cro-component="case-study-proof"
      data-variant={variant}
      aria-labelledby={titleId}
      data-pagefind-body
    >
      <div class="container">
        <header class="case-study-proof-head">
          <p class="eyebrow">{copy.eyebrow}</p>
          <h2 id={titleId}>{copy.title}</h2>
          <p class="case-study-proof-lede">{copy.lede}</p>
        </header>

        <div
          class="case-study-proof-tabs"
          role="tablist"
          aria-label={copy.filtersLabel}
          data-proof-tablist
        >
          {items.map((item, index) => (
            <button
              type="button"
              class:list={['case-study-proof-tab', { 'is-active': index === defaultIndex }]}
              role="tab"
              id={tabId(item.industryId)}
              data-industry={item.industryId}
              aria-selected={index === defaultIndex ? 'true' : 'false'}
              aria-controls={panelId(item.industryId)}
              tabindex={index === defaultIndex ? 0 : -1}
            >
              {item.industryLabel}
            </button>
          ))}
        </div>

        {items.map((item, index) => (
          <div
            class="case-study-proof-panel"
            role="tabpanel"
            id={panelId(item.industryId)}
            aria-labelledby={tabId(item.industryId)}
            hidden={index !== defaultIndex}
            data-proof-panel
            data-industry={item.industryId}
          >
            {variant === 'v1' ? (
              <div class="case-study-proof-row case-study-proof-row--v1">
                <p class="case-study-proof-stat">{item.stat}</p>
                <div>
                  <p class="case-study-proof-story-title">{item.title}</p>
                  <a class="case-study-proof-link" href={item.href}>
                    {item.linkText}
                  </a>
                </div>
              </div>
            ) : (
              <div class="case-study-proof-row case-study-proof-row--v2">
                <p class="case-study-proof-stat">{item.stat}</p>
                <div class="case-study-proof-body">
                  <span class="case-study-proof-badge">{item.badge}</span>
                  <p class="case-study-proof-story-title">{item.title}</p>
                  <a class="btn btn-primary case-study-proof-cta" href={item.href}>
                    {item.linkText}
                  </a>
                </div>
              </div>
            )}
          </div>
        ))}
      </div>
    </section>
  )
}

<script>
  function initCaseStudyProofBars() {
    document.querySelectorAll('[data-cro-component="case-study-proof"]').forEach((section) => {
      if (!(section instanceof HTMLElement)) return;
      const tablist = section.querySelector('[data-proof-tablist]');
      if (!(tablist instanceof HTMLElement)) return;
      const tabs = Array.from(tablist.querySelectorAll('[role="tab"]')).filter(
        (el) => el instanceof HTMLButtonElement,
      );
      const panels = Array.from(section.querySelectorAll('[data-proof-panel]')).filter(
        (el) => el instanceof HTMLElement,
      );

      function activate(industryId) {
        for (const tab of tabs) {
          const selected = tab.dataset.industry === industryId;
          tab.setAttribute('aria-selected', selected ? 'true' : 'false');
          tab.tabIndex = selected ? 0 : -1;
          tab.classList.toggle('is-active', selected);
        }
        for (const panel of panels) {
          if (panel.dataset.industry === industryId) panel.removeAttribute('hidden');
          else panel.setAttribute('hidden', '');
        }
      }

      tablist.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const tab = target.closest('[role="tab"]');
        if (!(tab instanceof HTMLButtonElement) || !tablist.contains(tab)) return;
        activate(tab.dataset.industry);
      });

      tablist.addEventListener('keydown', (event) => {
        if (!(event instanceof KeyboardEvent)) return;
        const current = tabs.findIndex((tab) => tab.tabIndex === 0);
        if (current < 0) return;
        let next = current;
        if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (current + 1) % tabs.length;
        else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp')
          next = (current - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          activate(tabs[current].dataset.industry);
          return;
        } else return;
        event.preventDefault();
        const tab = tabs[next];
        activate(tab.dataset.industry);
        tab.focus();
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCaseStudyProofBars, { once: true });
  } else {
    initCaseStudyProofBars();
  }
</script>

<style>
  .case-study-proof {
    background:
      linear-gradient(180deg, rgba(15, 44, 76, 0.04), transparent 42%),
      var(--white);
    padding: var(--section-pad-y) 0;
    border-bottom: 1px solid rgba(15, 44, 76, 0.08);
  }

  .case-study-proof-head {
    max-width: 40rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }

  .case-study-proof h2 {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    margin: 0.5rem 0 0.75rem;
    color: var(--navy);
  }

  .case-study-proof-lede {
    margin: 0;
    color: var(--body-muted);
    font-size: 1.015rem;
    line-height: 1.6;
  }

  .case-study-proof-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.1rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid rgba(15, 44, 76, 0.14);
  }

  .case-study-proof-tab {
    appearance: none;
    background: transparent;
    border: 0;
    border-bottom: 2px solid transparent;
    margin: 0 0 -1px;
    padding: 0.6rem 0.75rem;
    color: var(--body-muted);
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
  }

  .case-study-proof-tab:hover,
  .case-study-proof-tab:focus-visible,
  .case-study-proof-tab.is-active,
  .case-study-proof-tab[aria-selected='true'] {
    color: var(--navy);
  }

  .case-study-proof-tab.is-active,
  .case-study-proof-tab[aria-selected='true'] {
    border-bottom-color: var(--coral);
  }

  .case-study-proof-tab:focus-visible {
    outline: 2px solid var(--coral);
    outline-offset: 2px;
  }

  .case-study-proof-panel[hidden] {
    display: none !important;
  }

  .case-study-proof-row--v1 {
    display: grid;
    gap: 0.75rem 1.5rem;
  }

  @media (min-width: 640px) {
    .case-study-proof-row--v1 {
      grid-template-columns: minmax(8rem, auto) 1fr;
      align-items: baseline;
    }
  }

  .case-study-proof-stat {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--coral);
    letter-spacing: -0.02em;
  }

  .case-study-proof--v1 .case-study-proof-stat {
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
  }

  .case-study-proof-story-title {
    margin: 0 0 0.35rem;
    color: var(--navy);
    font-weight: 600;
    line-height: 1.4;
  }

  .case-study-proof-link {
    color: var(--navy);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .case-study-proof-link:hover,
  .case-study-proof-link:focus-visible {
    color: var(--coral);
  }

  .case-study-proof-row--v2 {
    display: grid;
    gap: 1rem;
    padding: 1.25rem 0 0.25rem;
  }

  @media (min-width: 720px) {
    .case-study-proof-row--v2 {
      grid-template-columns: minmax(10rem, auto) 1fr;
      gap: 1.75rem;
      align-items: start;
    }
  }

  .case-study-proof--v2 .case-study-proof-stat {
    font-size: clamp(2rem, 4vw, 2.75rem);
    line-height: 1.05;
  }

  .case-study-proof-body {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
  }

  .case-study-proof-badge {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--coral);
  }

  .case-study-proof-cta {
    margin-top: 0.25rem;
  }
</style>
