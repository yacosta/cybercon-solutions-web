---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import CroOrchestrator from '../components/cro/CroOrchestrator.astro';
import CaseStudyProofBar from '../components/cro/CaseStudyProofBar.astro';
import ProblemSelector from '../components/cro/ProblemSelector.astro';
import StickyMobileCta from '../components/cro/StickyMobileCta.astro';
import AssessmentForm from '../components/AssessmentForm.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import EngagementWorks from '../components/EngagementWorks.astro';
import IndustriesSection from '../components/IndustriesSection.astro';
import { getMessages } from '../i18n';

const locale = 'en' as const;
const t = getMessages(locale);
---

<BaseLayout locale={locale} path="/">
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/avif"
    imagesrcset="/videos/hero-poster-768.avif 768w, /videos/hero-poster-960.avif 960w, /videos/hero-poster.avif 1280w"
    imagesizes="100vw"
    fetchpriority="high"
  />

  <div slot="header" class="hero-shell">
    <Header locale={locale} t={t} variant="dark" />
  </div>

  <CroOrchestrator />

  <Hero locale={locale} t={t} />

  <!-- CRO-004: Control = hidden; V1 compact row; V2 bold outcome callout -->
  <div data-cro-experiment="cro-004" hidden>
    <div data-cro-arm-show="V1" hidden>
      <CaseStudyProofBar locale={locale} t={t} variant="v1" />
    </div>
    <div data-cro-arm-show="V2" hidden>
      <CaseStudyProofBar locale={locale} t={t} variant="v2" />
    </div>
  </div>

  <IndustriesSection locale={locale} t={t} />

  <ServicesGrid
    locale={locale}
    eyebrow={t.services.eyebrow}
    title={t.services.title}
    lede={t.services.lede}
    learnMoreAbout={t.services.learnMoreAbout}
  />

  <EngagementWorks t={t} />

  <!-- CRO-003: problem selector above assessment -->
  <div data-cro-experiment="cro-003" hidden>
    <div data-cro-arm-show="V1" hidden>
      <ProblemSelector locale={locale} t={t} variant="v1" />
    </div>
    <div data-cro-arm-show="V2" hidden>
      <ProblemSelector locale={locale} t={t} variant="v2" />
    </div>
  </div>

  <AssessmentForm locale={locale} t={t} />

  <StickyMobileCta locale={locale} t={t} variant="v1" />

  <Footer slot="footer" locale={locale} t={t} />
</BaseLayout>

<style>
  .hero-shell {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 3;
  }
</style>
