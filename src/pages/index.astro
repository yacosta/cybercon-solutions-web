---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ProblemsSection from '../components/ProblemsSection.astro';
import PillarsSection from '../components/PillarsSection.astro';
import EvidenceSection from '../components/EvidenceSection.astro';
import FitCoverageSection from '../components/FitCoverageSection.astro';
import AssessmentForm from '../components/AssessmentForm.astro';
import IndustriesSection from '../components/IndustriesSection.astro';
import { getMessages } from '../i18n';

const locale = 'en' as const;
const t = getMessages(locale);
---

<BaseLayout locale={locale} path="/">
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/avif"
    imagesrcset="/videos/hero-poster-768.avif 768w, /videos/hero-poster-960.avif 960w, /videos/hero-poster.avif 1280w"
    imagesizes="100vw"
    fetchpriority="high"
  />

  <div slot="header" class="hero-shell">
    <Header locale={locale} t={t} variant="dark" />
  </div>

  <Hero locale={locale} t={t} />
  <TrustStrip locale={locale} t={t} />
  <ProblemsSection t={t} />
  <PillarsSection locale={locale} t={t} />
  <EvidenceSection locale={locale} t={t} />
  <FitCoverageSection t={t} />
  <IndustriesSection locale={locale} t={t} />
  <AssessmentForm locale={locale} t={t} />

  <Footer slot="footer" locale={locale} t={t} />
</BaseLayout>

<style>
  .hero-shell {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 3;
  }
</style>
