---
export const prerender = true;
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SiteCheck from '../../../components/SiteCheck.astro';
import { getMessages, localePath } from '../../../i18n';

const locale = 'es' as const;
const t = getMessages(locale);
---

<BaseLayout
  locale={locale}
  path="/es/site-check/"
  title={t.siteCheck.metaTitle}
  description={t.siteCheck.metaDescription}
  breadcrumbs={[
    { name: t.nav.home, path: '/es/' },
    { name: t.siteCheck.nav, path: '/es/site-check/' },
  ]}
>
  <Header slot="header" locale={locale} t={t} variant="light" />
  <SiteCheck locale={locale} t={t} variant="page" />
  <p class="back-home">
    <a href={localePath(locale, '/')}>{t.nav.home}</a>
    {' · '}
    <a href={localePath(locale, '/assessment/')}>{t.siteCheck.bookCta}</a>
  </p>
  <Footer slot="footer" locale={locale} t={t} />
</BaseLayout>

<style>
  .back-home {
    text-align: center;
    padding: 0 1rem 2.5rem;
    margin: 0;
    background: #061424;
    color: rgba(247, 245, 241, 0.7);
    font-size: 0.9rem;
  }

  .back-home a {
    color: #f7f5f1;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
