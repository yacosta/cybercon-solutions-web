---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AssessmentForm from '../../components/AssessmentForm.astro';
import { getMessages } from '../../i18n';

const locale = 'en' as const;
const t = getMessages(locale);
---

<BaseLayout
  locale={locale}
  title={`${t.form.title} | Cybercon`}
  description={t.form.lede}
  path="/assessment/"
>
  <Header slot="header" locale={locale} t={t} variant="light" />

  <AssessmentForm locale={locale} t={t} layout="split" />

  <Footer slot="footer" locale={locale} t={t} />
</BaseLayout>
