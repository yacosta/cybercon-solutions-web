{
  "name": "cybercon-solutions-web",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/wrap-worker-wp-query.mjs && npm run pagefind",
    "pagefind": "pagefind --site dist/client --output-path dist/client/pagefind",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types": "wrangler types",
    "deploy": "npm run build && wrangler deploy",
    "cf:deploy": "wrangler deploy",
    "cf:zaraz-cache": "node scripts/ensure-zaraz-cache-header.mjs",
    "cf:purge-cache": "node scripts/purge-cloudflare-cache.mjs",
    "cf:wp-query-redirect": "node scripts/ensure-wp-query-redirect.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.5",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.9",
    "jose": "^6.2.3",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.127.1"
  },
  "devDependencies": {
    "pagefind": "^1.5.2"
  }
}
